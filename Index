          if (appState.autoSaveLocal !== false) {
            triggerJpegBlobDownload(finalJpeg, fName);
          }

          idx++;
          setTimeout(nextItem, 220);
        };
        img.src = qItem.dataUrl;
      }
      nextItem();
    }

    function captureAndStampPhoto() {
      updateStateFromInputs();
      if (studioImageObj && studioMultiQueue.length > 1) {
        runStudioMultiPhotoProcessing();
        return;
      }
      lastMultiRenderedList = [];
      var multiBox = document.getElementById('previewMultiResultsList');
      if (multiBox) multiBox.classList.add('hidden');
      var canvas = document.getElementById('mainCanvas');
      var video = document.getElementById('cameraVideo');
      var source = studioImageObj ? studioImageObj : (video.readyState >= 2 ? video : null);

      // Determine final HD output dimensions (Landscape vs Portrait)
      var dims = getHdDimensionsForRatio(appState.aspectRatio, appState.hdQualityMode);
      var shortSide = dims.shortSide;
      var longSide = dims.longSide;
      var outW = (isLandscapeCanvas && appState.aspectRatio !== '1:1') ? longSide : shortSide;
      var outH = (isLandscapeCanvas && appState.aspectRatio !== '1:1') ? shortSide : longSide;

      // Prepare upright source frame with high-quality bicubic smoothing
      var preparedSource = source;
      if (source) {
        var rawCanvas = document.createElement('canvas');
        rawCanvas.width = outW;
        rawCanvas.height = outH;
        var rCtx = rawCanvas.getContext('2d');
        rCtx.imageSmoothingEnabled = true;
        rCtx.imageSmoothingQuality = 'high';
        var sw = source.videoWidth || source.naturalWidth || outW;
        var sh = source.videoHeight || source.naturalHeight || outH;

        if (!studioImageObj && isLandscapeCanvas && sw < sh && outW > outH) {
          rCtx.save();
          if (physicalLandscapeDir === 'right') {
            rCtx.translate(outW / 2, outH / 2);
            rCtx.rotate(Math.PI / 2);
          } else {
            rCtx.translate(outW / 2, outH / 2);
            rCtx.rotate(-Math.PI / 2);
          }
          var sCoverRot = Math.max(outW / sh, outH / sw);
          var dwRot = sw * sCoverRot;
          var dhRot = sh * sCoverRot;
          rCtx.drawImage(source, -dwRot / 2, -dhRot / 2, dwRot, dhRot);
          rCtx.restore();
        } else {
          var sCover = Math.max(outW / sw, outH / sh);
          var dw = sw * sCover;
          var dh = sh * sCover;
          rCtx.drawImage(source, (outW - dw) / 2, (outH - dh) / 2, dw, dh);
        }
        if (!studioImageObj) {
          lastRawFrameDataUrl = rawCanvas.toDataURL('image/jpeg', 0.88);
        }
        preparedSource = rawCanvas;
      }

      // Apply Micro-Jitter GPS & fresh 14-char synced Photo Code + Serial Code
      var jittered = applyMicroJitterCoords(appState.lat, appState.lng, appState.microJitter);
      appState.lat = jittered.lat;
      appState.lng = jittered.lng;
      document.getElementById('inpLat').value = appState.lat;
      document.getElementById('inpLng').value = appState.lng;
      regeneratePhotoCode();

      var clk = formatIndonesianDateObject(appState.manualDate, appState.manualTime, appState.liveClock);
      var offCanvas = document.createElement('canvas');
      offCanvas.width = outW;
      offCanvas.height = outH;
      var offCtx = offCanvas.getContext('2d');
      offCtx.imageSmoothingEnabled = true;
      offCtx.imageSmoothingQuality = 'high';

      drawUnifiedWatermark(offCtx, offCanvas.width, offCanvas.height, preparedSource, appState, clk, jittered, appState.photoCode, true);

      var compressed = encodeCrispHdJpeg(offCanvas, appState.hdQualityMode);
      lastRenderedDataUrl = injectExifIntoJpeg(
        compressed.dataUrl,
        appState.exifDevice,
        clk.exifDateStr,
        jittered.lat,
        jittered.lng,
        outW,
        outH,
        appState.altitude,
        appState.photoCode
      );
      var finalKb = Math.max(1, Math.round(((lastRenderedDataUrl.length - 23) * 0.75) / 1024));

      document.getElementById('previewModalImg').src = lastRenderedDataUrl;
      document.getElementById('previewModalMeta').textContent =
        outW + 'x' + outH + 'px HD (' + finalKb + ' KB) • ' + appState.exifDevice.replace('|', ' ') + ' • Kode: ' + appState.photoCode;

      var verified = verifyInjectedExifSummary(lastRenderedDataUrl);
      var statusBox = document.getElementById('previewExifStatusBox');
      if (statusBox) {
        if (verified && Math.abs(verified.latDec - jittered.lat) < 0.001) {
          statusBox.innerHTML =
            '<div class="text-emerald-400 font-bold">✓ Geo-Location EXIF + XMP + Segel Anti-WhatsApp Aktif:</div>' +
            '<div>Kamera : ' + verified.make + ' ' + verified.model + ' (f/1.8, 1/125s, ISO 100, 24mm)</div>' +
            '<div>GPS DMS: ' + verified.latDec.toFixed(6) + ', ' + verified.lngDec.toFixed(6) + ' (Alt: ' + verified.altM + 'm, WGS-84, Status: A)</div>' +
            '<div>Waktu  : ' + verified.dateTime + ' (UTC DateStamp: ' + verified.gpsDate + ')</div>' +
            '<div class="text-amber-300 font-semibold">Segel Piksel: 160-Bit Optical Matrix (Tahan Kompresi WhatsApp)</div>';
        } else {
          statusBox.innerHTML = '<div class="text-amber-400">Metadata EXIF, XMP & Segel Piksel disematkan ke foto</div>';
        }
      }
      var nowLocal = new Date(new Date().getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 10);
      var capDate = appState.liveClock ? nowLocal : (appState.manualDate || nowLocal);
      var fileName = 'TrustMark_' + appState.photoCode + '.jpg';

      // 1. Save to Local Offline App History & execute pre-selected actions (Save HP / Save Drive) without blocking pop-up
      var snapCode = appState.photoCode;
      var snapLat = jittered.lat;
      var snapLng = jittered.lng;
