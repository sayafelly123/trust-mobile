        if (window.lucide) window.lucide.createIcons();
      }
      if (lblHdr) lblHdr.textContent = 'Syncing...';

      suppressAutoPush = true;
      ensureAllLogosReadyForSync(function() {
        var payloadObj = buildFullTemplatePayload();
        suppressAutoPush = false;
        var payloadStr = JSON.stringify(payloadObj);
        if (payloadStr.length > 440000) {
          payloadObj.logo3DataUrl = '';
          payloadStr = JSON.stringify(payloadObj);
        }

        callBackend('savePreset', {
          type: 'logo',
          name: MASTER_SYNC_NAME,
          dataJson: payloadStr
        }, function(data) {
          if (btn && !isSilentAuto) {
