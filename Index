    function initAndroidBackGuard() {
      pushBackGuardState();
      // ponytail: Chrome Android requires 1 user touch before history.pushState traps hardware Back
      var armOnFirstTouch = function() {
        pushBackGuardState();
        window.removeEventListener('pointerdown', armOnFirstTouch, true);
      };
