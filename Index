        img.onload = function() {
          // +1 minute per photo from the first photo (idx=0 is baseDate, idx=1 is +1m, idx=2 is +2m...)
          var photoTime = new Date(baseDate.getTime() + (idx * 60000));
          var tzOff = photoTime.getTimezoneOffset() * 60000;
          var dStr = new Date(photoTime.getTime() - tzOff).toISOString().slice(0, 10);
          var tStr = photoTime.toTimeString().slice(0, 8);
          var clk = formatIndonesianDateObject(dStr, tStr, false);

          // Unique 14-char verification code per photo
          var code14 = generateRandomCode(14);
          while (usedCodes[code14]) { code14 = generateRandomCode(14); }
          usedCodes[code14] = true;

          // Shift GPS & Minimap by 1-2 meters uniquely for each photo
          var jittered = applyMicroJitterCoords(baseLat, baseLng, true, idx + 1);

          var dims = getHdDimensionsForRatio(appState.aspectRatio, appState.hdQualityMode);
          var isLandImg = img.naturalWidth > img.naturalHeight;
          var outW = (isLandImg && appState.aspectRatio !== '1:1') ? dims.longSide : dims.shortSide;
          var outH = (isLandImg && appState.aspectRatio !== '1:1') ? dims.shortSide : dims.longSide;

          var offCanvas = document.createElement('canvas');
