    function syncPrecisionSlidersFromElement() {
      var sel = document.getElementById('selTargetElement');
      if (!sel) return;
      var key = sel.value || 'textBlock';
      var pos = getTargetPositionRef(key);
      var xPct = Math.round(pos.rx * 200) / 2;
      var yPct = Math.round(pos.ry * 200) / 2;
      document.getElementById('rngPosX').value = xPct;
      document.getElementById('rngPosY').value = yPct;
      if (key.indexOf('sub_') === 0) {
        var offX = Math.round((pos.rx - 0.50) * 600);
        var offY = Math.round((pos.ry - 0.50) * 600);
        document.getElementById('valPosX').textContent = (offX >= 0 ? '+' : '') + offX + 'px';
        document.getElementById('valPosY').textContent = (offY >= 0 ? '+' : '') + offY + 'px';
      } else {
        document.getElementById('valPosX').textContent = xPct + '%';
        document.getElementById('valPosY').textContent = yPct + '%';
      }
