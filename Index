    function initFloatingWindowDrag() {
      var win = document.getElementById('floatingQuickWindow');
      var hdr = document.getElementById('floatingQuickHeader');
      if (!win || !hdr) return;
      var dragging = false;
      var startX = 0;
      var startY = 0;
      var origLeft = 0;
      var origTop = 0;

      hdr.addEventListener('pointerdown', function(e) {
        if (e.target.closest('button')) return;
        dragging = true;
        var rect = win.getBoundingClientRect();
        var parentRect = win.parentElement.getBoundingClientRect();
        origLeft = rect.left - parentRect.left;
        origTop = rect.top - parentRect.top;
        startX = e.clientX;
        startY = e.clientY;
        hdr.setPointerCapture(e.pointerId);
      });

      hdr.addEventListener('pointermove', function(e) {
        if (!dragging) return;
        var parentRect = win.parentElement.getBoundingClientRect();
        var newLeft = Math.max(4, Math.min(parentRect.width - win.offsetWidth - 4, origLeft + (e.clientX - startX)));
        var newTop = Math.max(4, Math.min(parentRect.height - win.offsetHeight - 4, origTop + (e.clientY - startY)));
        win.style.left = newLeft + 'px';
        win.style.top = newTop + 'px';
        win.style.right = 'auto';
      });

      hdr.addEventListener('pointerup', function() {
        dragging = false;
      });
    }

