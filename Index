    function renderSingleAnalogCanvas(c, t) {
      if (!c) return;
      var ctx = c.getContext('2d');
      var w = c.width;
      var h = c.height;
      var cx = w / 2;
      var cy = h / 2;
      var r = (w / 2) - 6;

      ctx.clearRect(0, 0, w, h);
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = '#0f172a';
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = analogDragTarget === 'minute' ? '#f59e0b' : '#10b981';
      ctx.stroke();

      for (var i = 0; i < 12; i++) {
        var ang = (i * 30 - 90) * Math.PI / 180;
        var tx1 = cx + Math.cos(ang) * (r - 8);
        var ty1 = cy + Math.sin(ang) * (r - 8);
        ctx.font = '700 9px Inter, sans-serif';
        ctx.fillStyle = '#94a3b8';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(String(i === 0 ? 12 : i), tx1, ty1);
      }

      var hrAng = (((t.h % 12) + t.m / 60) * 30 - 90) * Math.PI / 180;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(hrAng) * (r * 0.48), cy + Math.sin(hrAng) * (r * 0.48));
      ctx.strokeStyle = analogDragTarget === 'hour' ? '#10b981' : '#e2e8f0';
      ctx.lineWidth = 4;
      ctx.lineCap = 'round';
      ctx.stroke();

      var minAng = ((t.m * 6) - 90) * Math.PI / 180;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(minAng) * (r * 0.72), cy + Math.sin(minAng) * (r * 0.72));
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 2.8;
      ctx.lineCap = 'round';
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(cx, cy, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = '#f59e0b';
      ctx.fill();
    }

    function drawAnalogClockDial() {
      var t = parseManualTimeHMS();
      renderSingleAnalogCanvas(document.getElementById('analogClockCanvas'), t);
      renderSingleAnalogCanvas(document.getElementById('modalAnalogClockCanvas'), t);
      var ampmBtn = document.getElementById('btnAnalogAmPm');
      if (ampmBtn) {
        ampmBtn.textContent = (t.h >= 12 ? 'PM (' : 'AM (') + String(t.h).padStart(2, '0') + ':' + String(t.m).padStart(2, '0') + ')';
      }
      syncModalTimeInputs();
      if (false) {
      var c = document.getElementById('analogClockCanvas');
      if (!c) return;
      var ctx = c.getContext('2d');
      var w = c.width;
      var h = c.height;
      var cx = w / 2;
      var cy = h / 2;
      var r = (w / 2) - 6;
      var t = parseManualTimeHMS();

      ctx.clearRect(0, 0, w, h);
      ctx.beginPath();
      ctx.arc(cx, cy, r, 0, Math.PI * 2);
      ctx.fillStyle = '#0f172a';
      ctx.fill();
      ctx.lineWidth = 2.5;
      ctx.strokeStyle = analogDragTarget === 'minute' ? '#f59e0b' : '#10b981';
      ctx.stroke();

      for (var i = 0; i < 12; i++) {
        var ang = (i * 30 - 90) * Math.PI / 180;
        var tx1 = cx + Math.cos(ang) * (r - 8);
        var ty1 = cy + Math.sin(ang) * (r - 8);
        ctx.font = '700 9px Inter, sans-serif';
        ctx.fillStyle = '#94a3b8';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(String(i === 0 ? 12 : i), tx1, ty1);
      }

      // Hour hand
      var hrAng = (((t.h % 12) + t.m / 60) * 30 - 90) * Math.PI / 180;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(hrAng) * (r * 0.48), cy + Math.sin(hrAng) * (r * 0.48));
      ctx.strokeStyle = analogDragTarget === 'hour' ? '#10b981' : '#e2e8f0';
      ctx.lineWidth = 4;
      ctx.lineCap = 'round';
      ctx.stroke();

      // Minute hand
      var minAng = ((t.m * 6) - 90) * Math.PI / 180;
      ctx.beginPath();
      ctx.moveTo(cx, cy);
      ctx.lineTo(cx + Math.cos(minAng) * (r * 0.72), cy + Math.sin(minAng) * (r * 0.72));
      ctx.strokeStyle = '#f59e0b';
      ctx.lineWidth = 2.8;
      ctx.lineCap = 'round';
      ctx.stroke();

      // Center cap & digital badge
      ctx.beginPath();
      ctx.arc(cx, cy, 4.5, 0, Math.PI * 2);
      ctx.fillStyle = '#f59e0b';
      ctx.fill();

      var ampmBtn = document.getElementById('btnAnalogAmPm');
      if (ampmBtn) {
        ampmBtn.textContent = (t.h >= 12 ? 'PM (' : 'AM (') + String(t.h).padStart(2, '0') + ':' + String(t.m).padStart(2, '0') + ')';
      }
      }
    }

    function handleAnalogPointer(e, isFirstDown, targetCanvas) {
      var c = targetCanvas || document.getElementById('analogClockCanvas');
      if (!c) return;
      var rect = c.getBoundingClientRect();
      var dx = (e.clientX - rect.left) - (rect.width / 2);
      var dy = (e.clientY - rect.top) - (rect.height / 2);
      var dist = Math.sqrt(dx * dx + dy * dy);
      if (isFirstDown) {
        // Inner circle automatically grabs Hour hand, outer ring grabs Minute hand
        if (dist < rect.width * 0.24) {
          setAnalogDragTarget('hour');
        }
      }
      var deg = (Math.atan2(dy, dx) * 180 / Math.PI + 90 + 360) % 360;
      var t = parseManualTimeHMS();
      if (analogDragTarget === 'hour') {
        var isPm = t.h >= 12;
        var h12 = Math.round(deg / 30) % 12;
        applyAnalogTimeHMS(isPm ? (h12 + 12) : h12, t.m, t.s);
      } else {
        var newMin = Math.round(deg / 6) % 60;
        var newHr = t.h;
        if (lastAnalogMinute !== null) {
          if (lastAnalogMinute > 45 && newMin < 15) newHr = (newHr + 1) % 24;
          else if (lastAnalogMinute < 15 && newMin > 45) newHr = (newHr + 23) % 24;
        }
        lastAnalogMinute = newMin;
        applyAnalogTimeHMS(newHr, newMin, t.s);
      }
    }

    function bindAnalogCanvasEvents(c) {
      if (!c) return;
      c.addEventListener('pointerdown', function(e) {
        isDraggingAnalog = true;
        lastAnalogMinute = parseManualTimeHMS().m;
        c.setPointerCapture(e.pointerId);
        handleAnalogPointer(e, true, c);
      });
      c.addEventListener('pointermove', function(e) {
        if (!isDraggingAnalog) return;
        handleAnalogPointer(e, false, c);
      });
      c.addEventListener('pointerup', function() {
        isDraggingAnalog = false;
        lastAnalogMinute = null;
      });
    }

