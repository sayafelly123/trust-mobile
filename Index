    function applyFullTemplateData(d, labelName) {
      if (!d || typeof d !== 'object') return;
      suppressAutoPush = true;
      var syncKeys = [
        'company', 'note', 'street', 'rt', 'rw', 'dusun', 'village',
        'district', 'city', 'province', 'postcode', 'address',
        'driveFolderUrl',
        'serialSuffix', 'autoSaveLocal', 'hdQualityMode', 'exifDevice', 'aspectRatio',
        'showMinimap', 'microJitter', 'clockFont', 'addrFont',
        'clockFontSize', 'addrFontSize', 'textColor', 'barColor',
        'barHeightPct', 'barWidthPx', 'textBg', 'edgeMarginPct', 'lockPosition',
        'scale', 'minimapScale', 'dateDayScale', 'metaScale', 'serialScale', 'brandScale',
        'addrWidth', 'strokeWidth',
        'logo1Enabled', 'logo1Anchor', 'logo1Plaque', 'logo1Size', 'logo1Height', 'logo1DataUrl',
        'logo2Enabled', 'logo2Anchor', 'logo2Plaque', 'logo2Size', 'logo2Height', 'logo2DataUrl',
        'logo3Enabled', 'logo3Width', 'logo3Height', 'brandTitle', 'brandSub', 'logo3DataUrl'
      ];
      for (var i = 0; i < syncKeys.length; i++) {
        var k = syncKeys[i];
        if (d[k] !== undefined) appState[k] = d[k];
      }
      if (!appState.userName && d.userName) {
        appState.userName = d.userName;
      }
      if (Array.isArray(d.deletedFonts)) {
        appState.deletedFonts = d.deletedFonts;
      }
      if (d.customFontData && typeof d.customFontData === 'object') {
        appState.customFontData = d.customFontData;
      }
      if (Array.isArray(d.customFonts)) {
        appState.customFonts = d.customFonts;
      }
      activateAndLoadCanvasFonts();
      if (d.positions) {
        for (var pk in d.positions) { appState.positions[pk] = d.positions[pk]; }
      }
      if (d.subOffsets) {
        if (!appState.subOffsets) appState.subOffsets = {};
        for (var sk in d.subOffsets) { appState.subOffsets[sk] = d.subOffsets[sk]; }
      }
      if (appState.logo1DataUrl) { loadLogoImageFromDataUrl(1, appState.logo1DataUrl); } else { logoImgs[1] = null; }
      if (appState.logo2DataUrl) { loadLogoImageFromDataUrl(2, appState.logo2DataUrl); } else { logoImgs[2] = null; }
      if (appState.logo3DataUrl) { loadLogoImageFromDataUrl(3, appState.logo3DataUrl); } else { logoImgs[3] = null; }
      changeAspectRatio(appState.aspectRatio || '3:4');
      syncInputsFromState();
      watermarkDirty = true;
      setTimeout(function() { activateAndLoadCanvasFonts(); watermarkDirty = true; }, 350);
      setTimeout(function() { watermarkDirty = true; }, 1000);
      saveState();
      suppressAutoPush = false;
      if (labelName) {
        showToast('Desain "' + labelName + '" berhasil disinkronkan!');
      }
    }

