    function findPhotoInLocalHistoryByCodePrefix(prefixStr) {
      var clean = String(prefixStr || '').trim().toUpperCase();
      if (!clean) return null;
      var list = getLocalPhotosList();
      for (var i = 0; i < list.length; i++) {
        var code = String(list[i].photoCode || '').toUpperCase();
        if (code === clean || (clean.length >= 6 && code.indexOf(clean) === 0)) {
          return list[i];
        }
      }
      return null;
    }

    function handleVerifyPhotoUpload(e) {
      var file = e.target.files && e.target.files[0];
      if (!file) return;
      var box = document.getElementById('verifyResultBox');
      if (box) {
        box.classList.remove('hidden');
        box.innerHTML = '<div class="text-amber-300 font-semibold">Memindai Segel Piksel Anti-WhatsApp & Header EXIF...</div>';
      }

      var reader = new FileReader();
      reader.onload = function(ev) {
        var dataUrl = ev.target.result;
        var exifSummary = verifyInjectedExifSummary(dataUrl);
        var hasValidExifGps = Boolean(exifSummary && (Math.abs(exifSummary.latDec) > 0.0001 || Math.abs(exifSummary.lngDec) > 0.0001));

        var img = new Image();
        img.onload = function() {
          var opticalSeal = decodeTrustMarkOpticalSealFromImage(img);
          renderPhotoVerificationReport(file.name, opticalSeal, exifSummary, hasValidExifGps);
        };
        img.src = dataUrl;
      };
      reader.readAsDataURL(file);
      e.target.value = '';
    }

    function renderPhotoVerificationReport(fileName, opticalSeal, exifSummary, hasValidExifGps) {
      var box = document.getElementById('verifyResultBox');
      if (!box) return;
      box.classList.remove('hidden');

      if (!opticalSeal && !hasValidExifGps) {
        box.innerHTML =
          '<div class="p-2.5 rounded-lg bg-rose-950/60 border border-rose-500/50 space-y-1">' +
            '<div class="text-xs font-bold text-rose-400">✕ TIDAK TERVERIFIKASI TRUSTMARK</div>' +
            '<div class="text-[10px] text-slate-300">Foto ini tidak memiliki Segel Piksel Optik TrustMark maupun metadata EXIF TrustMark.</div>' +
          '</div>';
        return;
      }

      var latFinal = opticalSeal ? opticalSeal.lat : (exifSummary ? exifSummary.latDec : 0);
      var lngFinal = opticalSeal ? opticalSeal.lng : (exifSummary ? exifSummary.lngDec : 0);
      var mapsUrl = 'https://www.google.com/maps?q=' + latFinal.toFixed(6) + ',' + lngFinal.toFixed(6);
      var localMatch = opticalSeal ? findPhotoInLocalHistoryByCodePrefix(opticalSeal.codePrefix6) : null;

      var html =
        '<div class="p-2.5 rounded-lg bg-emerald-950/60 border border-emerald-500/50 space-y-1.5">' +
          '<div class="text-xs font-bold text-emerald-400 flex items-center justify-between">' +
            '<span>✓ FOTO ASLI TERVERIFIKASI TRUSTMARK</span>' +
            '<span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 border border-emerald-500/40 mono">100% VALID</span>' +
          '</div>';

      if (opticalSeal) {
        html +=
          '<div class="bg-slate-900/90 border border-amber-500/40 rounded-lg p-2 space-y-1 mono text-[10px]">' +
            '<div class="text-amber-300 font-bold">★ Segel Piksel Anti-WhatsApp (Optical Seal ' + opticalSeal.crcHex + '): UTUH</div>' +
            '<div class="text-slate-200">Waktu Asli : ' + opticalSeal.formattedTime + '</div>' +
            '<div class="text-emerald-300">GPS Asli   : ' + opticalSeal.lat.toFixed(6) + ', ' + opticalSeal.lng.toFixed(6) + '</div>' +
            '<div class="text-slate-300">ID Segel   : ' + opticalSeal.codePrefix6 + '•••••••• (Terverifikasi Kriptografi)</div>' +
          '</div>';
      }

      if (hasValidExifGps) {
        html +=
          '<div class="bg-slate-900/90 border border-slate-700 rounded-lg p-2 space-y-0.5 mono text-[10px]">' +
            '<div class="text-blue-300 font-bold">✓ Header Binary EXIF &amp; XMP Geolocation: UTUH</div>' +
            '<div class="text-slate-300">Perangkat  : ' + exifSummary.make + ' ' + exifSummary.model + '</div>' +
            '<div class="text-slate-300">GPS EXIF   : ' + exifSummary.latDec.toFixed(6) + ', ' + exifSummary.lngDec.toFixed(6) + ' (' + exifSummary.altM + ' mdpl)</div>' +
          '</div>';
      } else if (opticalSeal) {
        html +=
          '<div class="bg-blue-950/50 border border-blue-500/40 rounded-lg p-2 text-[10px] text-blue-200">' +
            '<b>Info Transmisi:</b> Header EXIF standar telah dihapus oleh aplikasi pengirim (seperti WhatsApp), namun <b>Segel Piksel Optik TrustMark tetap bertahan 100%</b> dan berhasil memulihkan koordinat GPS serta waktu asli foto!' +
          '</div>';
      }

      if (localMatch) {
        html +=
          '<div class="bg-slate-900/90 border border-slate-700 rounded-lg p-2 space-y-0.5 text-[10px]">' +
            '<div class="text-amber-300 font-bold">✓ Cocok dengan Arsip Database:</div>' +
            '<div class="text-white font-semibold">Kode Foto: <span class="mono">' + localMatch.photoCode + '</span></div>' +
            '<div class="text-slate-300">Instansi : ' + (localMatch.company || '-') + '</div>' +
            '<div class="text-slate-400">' + (localMatch.address || '-') + '</div>' +
          '</div>';
      }

      html +=
        '<a href="' + mapsUrl + '" target="_blank" class="block w-full text-center bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[11px] py-1.5 rounded-lg">' +
          'Buka Titik Koordinat Asli di Google Maps' +
        '</a>' +
      '</div>';

      box.innerHTML = html;

      // Also query Cloud Spreadsheet if online and not yet matched locally
      if (opticalSeal && !localMatch && navigator.onLine !== false) {
        callBackend('verifyPhotoCode', { photoCode: opticalSeal.codePrefix6 }, function(res) {
          if (res && res.found && res.record) {
            var r = res.record;
            var cloudDiv = document.createElement('div');
            cloudDiv.className = 'bg-slate-900/90 border border-emerald-500/40 rounded-lg p-2 space-y-0.5 text-[10px] mt-1.5';
            cloudDiv.innerHTML =
              '<div class="text-emerald-400 font-bold">✓ Terdaftar di Cloud Database TrustMark:</div>' +
              '<div class="text-white font-semibold mono">Kode Penuh: ' + r.photoCode + '</div>' +
              '<div class="text-slate-300">Instansi  : ' + (r.company || '-') + '</div>' +
              '<div class="text-slate-400">' + (r.address || '-') + '</div>' +
              (r.driveUrl ? '<a href="' + r.driveUrl + '" target="_blank" class="text-amber-300 underline block pt-1">Lihat File Asli di Google Drive</a>' : '');
