    function runCodeVerification() {
      var inp = document.getElementById('inpVerifyCode');
      var code = String(inp ? inp.value : '').trim().toUpperCase();
      var box = document.getElementById('verifyResultBox');
      if (!code || code.length < 6) {
        showToast('Masukkan 14 karakter Kode Foto TrustMark');
        return;
      }
      box.classList.remove('hidden');

      var isMathValid = (code.length === 14) && verifyTrustMarkCodeChecksum(code);
      var localHit = findPhotoInLocalHistoryByCodePrefix(code);

      if (!isMathValid && !localHit) {
        box.innerHTML =
          '<div class="p-2.5 rounded-lg bg-rose-950/60 border border-rose-500/50 space-y-1">' +
            '<div class="text-xs font-bold text-rose-400">✕ KODE VERIFIKASI TIDAK VALID</div>' +
            '<div class="text-[10px] text-slate-300">Tanda tangan kriptografi 4-karakter terakhir pada kode <span class="mono font-bold text-white">' + code + '</span> tidak sesuai dengan algoritma resmi TrustMark.</div>' +
          '</div>';
        return;
      }

      box.innerHTML =
        '<div class="p-2.5 rounded-lg bg-emerald-950/60 border border-emerald-500/50 space-y-1.5">' +
          '<div class="text-xs font-bold text-emerald-400">✓ KODE KRIPTOGRAFI TRUSTMARK SAH</div>' +
          '<div class="text-[10px] text-slate-200 mono">Kode Foto: ' + code + '</div>' +
          (localHit
            ? '<div class="bg-slate-900 p-2 rounded border border-slate-700 text-[10px] space-y-0.5">' +
                '<div class="text-amber-300 font-bold">Data Arsip Lokal HP:</div>' +
                '<div class="text-white">Instansi: ' + (localHit.company || '-') + '</div>' +
                '<div class="text-emerald-300 mono">GPS: ' + Number(localHit.lat).toFixed(6) + ', ' + Number(localHit.lng).toFixed(6) + '</div>' +
                '<div class="text-slate-400">' + (localHit.address || '-') + '</div>' +
              '</div>'
            : '<div class="text-[10px] text-slate-400">Mencari detail arsip di Cloud Google Sheets...</div>') +
        '</div>';

      if (navigator.onLine !== false) {
        callBackend('verifyPhotoCode', { photoCode: code }, function(res) {
          if (res && res.found && res.record) {
            var r = res.record;
            box.innerHTML =
              '<div class="p-2.5 rounded-lg bg-emerald-950/60 border border-emerald-500/50 space-y-1.5">' +
                '<div class="text-xs font-bold text-emerald-400">✓ TERVERIFIKASI DI CLOUD DATABASE TRUSTMARK</div>' +
                '<div class="bg-slate-900 p-2 rounded border border-slate-700 text-[10px] space-y-0.5">' +
                  '<div class="text-amber-300 font-bold mono">Kode Foto : ' + r.photoCode + '</div>' +
                  '<div class="text-white">Instansi  : ' + (r.company || '-') + '</div>' +
                  '<div class="text-emerald-300 mono">Koordinat : ' + Number(r.lat).toFixed(6) + ', ' + Number(r.lng).toFixed(6) + '</div>' +
                  '<div class="text-slate-300">Alamat    : ' + (r.address || '-') + '</div>' +
                  (r.driveUrl ? '<a href="' + r.driveUrl + '" target="_blank" class="text-amber-400 underline block pt-1 font-bold">Buka Bukti Foto di Google Drive</a>' : '') +
                '</div>' +
              '</div>';
          }
        }, function() {});
      }
    }

    // RUNNABLE SELF-CHECK FOR NON-TRIVIAL LOGIC (EXIF DMS, MICRO-JITTER, 14-CHAR SYNC & RT/RW ADDRESS)
    function runClientSelfCheck() {
      var dms = degToDmsRational(-6.175392);
      if (!dms || dms.length !== 3 || dms[0][0] !== 6) {
        throw new Error('SelfCheck Failed: degToDmsRational invalid output');
      }
      var jit = applyMicroJitterCoords(-6.175392, 106.827153, true, 1);
      var jit2 = applyMicroJitterCoords(-6.175392, 106.827153, true, 2);
      if ((jit.lat === -6.175392 && jit.lng === 106.827153) || (jit.lat === jit2.lat && jit.lng === jit2.lng)) {
        throw new Error('SelfCheck Failed: applyMicroJitterCoords did not shift 1-2m uniquely');
      }
      if (appState.photoCode !== appState.serialCode || appState.photoCode.length !== 14) {
        throw new Error('SelfCheck Failed: 14-char photoCode and serialCode are not synchronized');
      }
      var testAddr = buildDetailedIndonesianAddress({ address: { road: 'Jl.Desa', house_number: '1', hamlet: 'Murjati', village: 'Lajuk', city_district: 'Gondang Wetan', city: 'Pasuruan', state: 'Jawa Timur', postcode: '67174' } }, -7.698258, 112.910856);
      if (testAddr.indexOf('RW.') === -1 || testAddr.indexOf('Murjati') === -1 || testAddr.indexOf('Lajuk') === -1) {
        throw new Error('SelfCheck Failed: buildDetailedIndonesianAddress missing detailed sub-villages');
      }
      var tplSnap = buildFullTemplatePayload();
      if (!tplSnap || !tplSnap.positions || !tplSnap.subOffsets || !tplSnap.clockFont) {
        throw new Error('SelfCheck Failed: buildFullTemplatePayload incomplete');
      }
      if (typeof handleBackNavigationStep !== 'function' || handleBackNavigationStep() !== 'root_camera') {
        throw new Error('SelfCheck Failed: handleBackNavigationStep root state mismatch');
      }
      if (Number(appState.edgeMarginPct) < 1.5) {
        throw new Error('SelfCheck Failed: minimum edge margin must be at least 1.5%');
      }
      if (!appState.barHeightPct || !appState.logo1Height || !appState.minimapScale) {
        throw new Error('SelfCheck Failed: individual scales and bar height/logo height must be initialized');
      }
      if (!appState.driveFolderUrl || appState.driveFolderUrl.indexOf('1r-lfCN2jz6noCazhbadezLz0GvIcP7ef') === -1) {
        throw new Error('SelfCheck Failed: default Drive folder URL missing');
      }
      if (typeof openNativeIndexedDB !== 'function' || typeof shareDataUrlNativeAndroid !== 'function') {
        throw new Error('SelfCheck Failed: Android Native IndexedDB or Share engine missing');
      }
      // Verify binary EXIF + GPS + JFIF-stripped + XMP round-trip injection AND WhatsApp-proof Optical Seal
      var testCode = generateRandomCode(14);
      if (!verifyTrustMarkCodeChecksum(testCode)) {
        throw new Error('SelfCheck Failed: 14-char cryptographic code checksum invalid');
      }
      var testC = document.createElement('canvas');
      testC.width = 320;
      testC.height = 320;
      var testCtx = testC.getContext('2d');
      testCtx.fillStyle = '#1e293b';
      testCtx.fillRect(0, 0, 320, 320);
      drawTrustMarkOpticalSeal(testCtx, 320, 320, { exifDateStr: '2026:10:23 09:42:15' }, { lat: -7.698258, lng: 112.910856 }, testCode);
      var testJpeg = testC.toDataURL('image/jpeg', 0.75);
      var injectedTest = injectExifIntoJpeg(testJpeg, 'Samsung|SM-S938B', '2026:10:23 09:42:15', -7.698258, 112.910856, 320, 320, 35.4, testCode);
      var ver = verifyInjectedExifSummary(injectedTest);
      if (!ver || String(ver.make).indexOf('Samsung') === -1 || Math.abs(ver.latDec - (-7.698258)) > 0.001) {
        throw new Error('SelfCheck Failed: EXIF & GPS binary injection failed round-trip verification');
      }
      var decodedSeal = decodeTrustMarkOpticalSealFromImage(testC);
      if (!decodedSeal || !decodedSeal.valid || Math.abs(decodedSeal.lat - (-7.698258)) > 0.00001 || decodedSeal.codePrefix6 !== testCode.slice(0, 6)) {
        throw new Error('SelfCheck Failed: WhatsApp-proof Optical Pixel Seal failed round-trip decode');
      }
    }
