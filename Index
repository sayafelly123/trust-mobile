    function deriveRtRwFromCoords(lat, lng) {
      var seed = Math.abs(Math.round((lat * 10000) + (lng * 10000)));
      var rtNum = String((seed % 14) + 1).padStart(3, '0');
      var rwNum = String((Math.floor(seed / 14) % 9) + 1).padStart(3, '0');
      return { rt: rtNum, rw: rwNum };
    }

    function composeAddressStringFromFields(street, rt, rw, dusun, village, district, city, province, postcode) {
      var parts = [];
      if (street) parts.push(street);
      var rtrwToken = '';
      if (rt && rw) {
        rtrwToken = 'RT.' + rt + '/RW.' + rw;
      } else if (rw) {
        rtrwToken = 'RW.' + rw;
      } else if (rt) {
        rtrwToken = 'RT.' + rt;
      }
      if (rtrwToken) parts.push(rtrwToken);
      if (dusun && dusun !== village) parts.push(dusun);
      if (village) parts.push(village);
      if (district) {
        parts.push(district.toLowerCase().indexOf('kec') === 0 ? district : ('Kec. ' + district));
      }
      if (city) {
        parts.push(city.replace(/^Kabupaten\s+/i, ''));
      }
      if (province || postcode) {
        parts.push((province ? province : '') + (postcode ? (' ' + postcode) : ''));
      }
      return parts.join(', ');
    }

    function composeAddressFromParts() {
      appState.street = (document.getElementById('inpStreet').value || '').trim();
      appState.rt = (document.getElementById('inpRt').value || '').trim();
      appState.rw = (document.getElementById('inpRw').value || '').trim();
      appState.dusun = (document.getElementById('inpDusun').value || '').trim();
      appState.village = (document.getElementById('inpVillage').value || '').trim();
      appState.district = (document.getElementById('inpDistrict').value || '').trim();
      appState.city = (document.getElementById('inpCity').value || '').trim();
      appState.province = (document.getElementById('inpProvince').value || '').trim();
      appState.postcode = (document.getElementById('inpPostcode').value || '').trim();

      var built = composeAddressStringFromFields(
        appState.street, appState.rt, appState.rw, appState.dusun,
        appState.village, appState.district, appState.city, appState.province, appState.postcode
      );
      if (built) {
        appState.address = built;
        document.getElementById('inpAddress').value = built;
      }
      watermarkDirty = true;
      saveState();
    }

    function buildDetailedIndonesianAddress(data, lat, lng) {
      var addr = (data && data.address) ? data.address : {};
      var disp = String((data && data.display_name) || '');

      var rtMatch = disp.match(/RT\.?\s*(\d{1,3})/i);
      var rwMatch = disp.match(/RW\.?\s*(\d{1,3})/i);
      var derived = deriveRtRwFromCoords(lat, lng);
      var rtStr = rtMatch ? rtMatch[1].padStart(2, '0') : (appState.rt !== undefined ? appState.rt : '');
      var rwStr = rwMatch ? rwMatch[1].padStart(2, '0') : (appState.rw || derived.rw.slice(-2));

      var roadPart = addr.road || addr.pedestrian || addr.footway || addr.path || addr.amenity || addr.building || addr.residential || 'Jl. Desa';
      if (addr.house_number) roadPart += ' Nomor ' + addr.house_number;
      var dusunPart = addr.hamlet || addr.neighbourhood || addr.quarter || '';
      var kelPart = addr.village || addr.suburb || addr.town || '';
      var kecPart = addr.city_district || addr.municipality || addr.county || '';
      var kabPart = (addr.city || addr.regency || addr.state_district || '').replace(/^Kabupaten\s+/i, '');
      var provPart = addr.state || '';
      var zipPart = addr.postcode || '';

      appState.street = roadPart;
      appState.rt = rtStr;
      appState.rw = rwStr;
      appState.dusun = dusunPart;
      appState.village = kelPart;
      appState.district = kecPart ? (kecPart.toLowerCase().indexOf('kec') === 0 ? kecPart : ('Kec. ' + kecPart)) : '';
      appState.city = kabPart;
      appState.province = provPart;
      appState.postcode = zipPart;

      if (document.getElementById('inpStreet')) document.getElementById('inpStreet').value = appState.street;
      if (document.getElementById('inpRt')) document.getElementById('inpRt').value = appState.rt;
      if (document.getElementById('inpRw')) document.getElementById('inpRw').value = appState.rw;
      if (document.getElementById('inpDusun')) document.getElementById('inpDusun').value = appState.dusun;
      if (document.getElementById('inpVillage')) document.getElementById('inpVillage').value = appState.village;
      if (document.getElementById('inpDistrict')) document.getElementById('inpDistrict').value = appState.district;
      if (document.getElementById('inpCity')) document.getElementById('inpCity').value = appState.city;
      if (document.getElementById('inpProvince')) document.getElementById('inpProvince').value = appState.province;
      if (document.getElementById('inpPostcode')) document.getElementById('inpPostcode').value = appState.postcode;

      var result = composeAddressStringFromFields(
        appState.street, appState.rt, appState.rw, appState.dusun,
        appState.village, appState.district, appState.city, appState.province, appState.postcode
      );
      return result || disp;
    }

    function fetchReverseGeocode(lat, lng, forceUpdateInput) {
      var derived = deriveRtRwFromCoords(lat, lng);
      appState.rt = derived.rt;
      appState.rw = derived.rw;
      var url = 'https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&extratags=1&namedetails=1&zoom=18&lat=' + lat + '&lon=' + lng;
      fetch(url, { headers: { 'Accept-Language': 'id' } })
        .then(function(r) { return r.json(); })
        .then(function(data) {
          if (data) {
            // Only overwrite address from live GPS if user is in live camera mode or explicitly picked from Map
            if (forceUpdateInput || appState.viewMode === 'camera') {
              var detailedAddr = buildDetailedIndonesianAddress(data, lat, lng);
              appState.address = detailedAddr;
              document.getElementById('inpAddress').value = detailedAddr;
              var previewEl = document.getElementById('mapModalAddressPreview');
              if (previewEl) previewEl.textContent = detailedAddr;
              syncFloatingWindowUI();
              watermarkDirty = true;
            }
            if (forceUpdateInput) saveState();
          }
        })
        .catch(function() {});
    }

    // MICRO-JITTER GPS (1 to 2 meters offset, guaranteed distinct angle & minimap pan between photos)
    var jitterStepCounter = 0;
    function applyMicroJitterCoords(lat, lng, enabled, explicitStepIdx) {
      var numLat = Number(lat);
      var numLng = Number(lng);
      if (isNaN(numLat)) numLat = -6.175392;
      if (isNaN(numLng)) numLng = 106.827153;
      if (!enabled) return { lat: numLat, lng: numLng, panDx: 0, panDy: 0 };
      var step = typeof explicitStepIdx === 'number' ? explicitStepIdx : (++jitterStepCounter);
      // 1.0 to 2.0 meters shift
      var meters = 1.0 + Math.random() * 1.0;
      // Golden-angle rotation ensures consecutive photos never shift in the same direction
      var angle = ((step * 2.399963) + (Math.random() * 0.55 - 0.275)) % (Math.PI * 2);
      var dLat = (meters * Math.cos(angle)) / 111320;
      var dLng = (meters * Math.sin(angle)) / (111320 * Math.cos(numLat * Math.PI / 180));
      var newLat = parseFloat((numLat + dLat).toFixed(6));
      var newLng = parseFloat((numLng + dLng).toFixed(6));
      if (newLat === numLat && newLng === numLng) {
        newLat = parseFloat((numLat + (step % 2 === 0 ? 0.000011 : -0.000011)).toFixed(6));
      }
      // Subtle 6-11px minimap pan + cone shift representing 1-2m physical movement
      var panRadius = Math.round(5 + meters * 3);
      return {
        lat: newLat,
        lng: newLng,
        panDx: Math.round(panRadius * Math.sin(angle)),
        panDy: Math.round(-panRadius * Math.cos(angle)),
        coneShiftRad: ( (step % 5) - 2 ) * 0.035
      };
    }

    // LEAFLET INTERACTIVE SATELLITE MAP MODAL
    function openMapModal() {
      document.getElementById('mapModal').classList.remove('hidden');
      document.getElementById('mapModalCoordPreview').textContent = appState.lat.toFixed(6) + ', ' + appState.lng.toFixed(6);
      document.getElementById('mapModalAddressPreview').textContent = appState.address;

      setTimeout(function() {
