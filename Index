    function savePhotoToLocalOfflineHistory(record) {
      cachedLocalPhotosMem.unshift(record);
      openNativeIndexedDB(function(db) {
        if (db) {
          try {
            var tx = db.transaction([NATIVE_IDB_STORE], 'readwrite');
            tx.objectStore(NATIVE_IDB_STORE).put(record);
          } catch (e) {}
        }
      });
      // ponytail: simpan versi ringkas di localStorage sebagai cadangan jika browser WebView lama belum mendukung IndexedDB
      try {
        var fallbackList = JSON.parse(localStorage.getItem(LOCAL_HISTORY_KEY) || '[]');
        fallbackList.unshift({
          id: record.id,
          fileName: record.fileName,
          thumbnail: record.thumbnail,
          lat: record.lat,
          lng: record.lng,
          address: record.address,
          company: record.company,
          note: record.note,
          captureDate: record.captureDate,
          photoCode: record.photoCode
        });
        if (fallbackList.length > 10) fallbackList = fallbackList.slice(0, 10);
        localStorage.setItem(LOCAL_HISTORY_KEY, JSON.stringify(fallbackList));
      } catch (e) {}
      renderLocalOfflineHistory();
    }

