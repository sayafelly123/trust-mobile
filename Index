    function parseManualTimeHMS() {
      var raw = appState.liveClock ? new Date().toTimeString().slice(0, 8) : (appState.manualTime || '09:42:15');
      var p = String(raw).split(':');
      return {
        h: Math.min(23, Math.max(0, parseInt(p[0], 10) || 0)),
        m: Math.min(59, Math.max(0, parseInt(p[1], 10) || 0)),
        s: Math.min(59, Math.max(0, parseInt(p[2], 10) || 0))
      };
    }

    function applyAnalogTimeHMS(h, m, s) {
      var hh = String(((h % 24) + 24) % 24).padStart(2, '0');
      var mm = String(((m % 60) + 60) % 60).padStart(2, '0');
      var ss = String(s !== undefined ? s : 15).padStart(2, '0');
      appState.liveClock = false;
      appState.manualTime = hh + ':' + mm + ':' + ss;
      document.getElementById('chkLiveClock').checked = false;
      document.getElementById('inpTime').value = appState.manualTime;
      syncFloatingWindowUI();
      drawAnalogClockDial();
      watermarkDirty = true;
      saveState();
    }

    function setAnalogDragTarget(target) {
      analogDragTarget = target === 'hour' ? 'hour' : 'minute';
      var minIds = ['btnAnalogMin', 'btnModalAnalogMin'];
      var hrIds = ['btnAnalogHour', 'btnModalAnalogHour'];
      for (var i = 0; i < minIds.length; i++) {
        var bMin = document.getElementById(minIds[i]);
        var bHr = document.getElementById(hrIds[i]);
        if (bMin && bHr) {
          bMin.className = analogDragTarget === 'minute'
            ? 'px-2 py-1 rounded text-[10px] font-bold bg-amber-500 text-slate-950'
            : 'px-2 py-1 rounded text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700';
          bHr.className = analogDragTarget === 'hour'
            ? 'px-2 py-1 rounded text-[10px] font-bold bg-amber-500 text-slate-950'
            : 'px-2 py-1 rounded text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700';
        }
      }
      drawAnalogClockDial();
    }

