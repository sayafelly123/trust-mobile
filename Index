    function getActiveAvailableFonts() {
      var deleted = Array.isArray(appState.deletedFonts) ? appState.deletedFonts : [];
      var list = [];
      for (var i = 0; i < BUILTIN_FONTS.length; i++) {
        if (deleted.indexOf(BUILTIN_FONTS[i]) === -1) list.push(BUILTIN_FONTS[i]);
      }
      var custom = Array.isArray(appState.customFonts) ? appState.customFonts : [];
      for (var j = 0; j < custom.length; j++) {
        if (custom[j] && list.indexOf(custom[j]) === -1 && deleted.indexOf(custom[j]) === -1) {
          list.push(custom[j]);
        }
      }
      if (appState.customFontData && typeof appState.customFontData === 'object') {
        for (var k in appState.customFontData) {
          if (k && list.indexOf(k) === -1 && deleted.indexOf(k) === -1) {
            list.push(k);
          }
        }
      }
      if (!list.length) list.push('Inter');
      return list;
    }

