    // ============================================================================
    // LAYER 1: WHATSAPP-PROOF OPTICAL PIXEL STEGANOGRAPHY ENGINE (160-BIT DIFFERENTIAL MATRIX)
    // ============================================================================
    function computeOpticalSealCrc8(bytes19) {
      var crc = 0x7B;
      for (var i = 0; i < 19; i++) {
        crc ^= (bytes19[i] & 0xFF);
        for (var b = 0; b < 8; b++) {
          if (crc & 0x80) {
            crc = ((crc << 1) ^ 0x31) & 0xFF;
          } else {
            crc = (crc << 1) & 0xFF;
          }
        }
      }
      return crc & 0xFF;
    }

    function buildOpticalSealPayloadBytes(clkObj, coordsObj, photoCodeStr) {
      var dParts = String((clkObj && clkObj.exifDateStr) || '2026:10:23 09:42:15').split(' ');
      var ymd = (dParts[0] || '2026:10:23').split(':');
      var hms = (dParts[1] || '09:42:15').split(':');
      var dt = new Date(
        parseInt(ymd[0], 10) || 2026,
