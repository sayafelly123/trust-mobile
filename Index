    var TM_CODE_ALPHABET = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';

    function computeTrustMarkCodeSignature(prefix10) {
      var clean = String(prefix10 || '').toUpperCase();
      var h1 = 0x544D2026;
      var h2 = 0x9E3779B9;
      for (var i = 0; i < clean.length; i++) {
        var c = clean.charCodeAt(i);
        h1 = Math.imul(h1 ^ c, 0x85EBCA6B) >>> 0;
        h2 = Math.imul(h2 ^ (c + i * 31), 0xC2B2AE35) >>> 0;
      }
      var sig = '';
      var combined = (h1 ^ h2) >>> 0;
      for (var j = 0; j < 4; j++) {
        sig += TM_CODE_ALPHABET.charAt((combined >>> (j * 5)) & 31);
      }
      return sig;
    }

    function verifyTrustMarkCodeChecksum(code14) {
      var clean = String(code14 || '').trim().toUpperCase();
      if (clean.length !== 14) return false;
      var prefix10 = clean.slice(0, 10);
      var sig4 = clean.slice(10, 14);
      return computeTrustMarkCodeSignature(prefix10) === sig4;
    }

    function generateRandomCode(len) {
      if (len && len !== 14) {
        var outShort = '';
        for (var s = 0; s < len; s++) {
          outShort += TM_CODE_ALPHABET.charAt(Math.floor(Math.random() * TM_CODE_ALPHABET.length));
        }
        return outShort;
      }
      var prefix10 = '';
      for (var i = 0; i < 10; i++) {
        prefix10 += TM_CODE_ALPHABET.charAt(Math.floor(Math.random() * TM_CODE_ALPHABET.length));
      }
      return prefix10 + computeTrustMarkCodeSignature(prefix10);
    }

