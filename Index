          cloudPresets.logo = data.logos || [];
          renderPresetLists();
          var sub = document.getElementById('syncStatusSub');
          if (sub) sub.textContent = 'Tersimpan di Cloud (' + Math.round(payloadStr.length / 1024) + ' KB). Ketuk "Tarik Sync" di HP.';
