    function dataUrlToBlob(dataUrl) {
      var parts = dataUrl.split(';base64,');
      var contentType = parts[0].split(':')[1] || 'image/jpeg';
      var raw = window.atob(parts[1]);
      var rawLength = raw.length;
      var uInt8Array = new Uint8Array(rawLength);
      for (var i = 0; i < rawLength; ++i) {
        uInt8Array[i] = raw.charCodeAt(i);
      }
      return new Blob([uInt8Array], { type: contentType });
    }

    function triggerJpegBlobDownload(jpegDataUrl, fileName) {
      try {
        var blob = dataUrlToBlob(jpegDataUrl);
        var blobUrl = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = blobUrl;
        a.download = fileName;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function() { URL.revokeObjectURL(blobUrl); }, 4000);
      } catch (e) {
        var aFallback = document.createElement('a');
        aFallback.href = jpegDataUrl;
        aFallback.download = fileName;
        document.body.appendChild(aFallback);
        aFallback.click();
        document.body.removeChild(aFallback);
      }
    }

    // SMART HD ANTI-PECAH ADAPTIVE JPEG ENCODER (4:2:0 Subsampling Sweet-Spot for Crisp Text + Minimal KB)
    function encodeCrispHdJpeg(canvas, qualityMode) {
      var mode = qualityMode || appState.hdQualityMode || 'hd_balanced';
      var initialQ = mode === 'fhd_ultra' ? 0.89 : (mode === 'hd_light' ? 0.78 : 0.85);
      var maxBytes = mode === 'fhd_ultra' ? 460000 : (mode === 'hd_light' ? 175000 : 285000);
      var minQ = mode === 'fhd_ultra' ? 0.82 : 0.74;

      var q = initialQ;
      var dataUrl = canvas.toDataURL('image/jpeg', q);
      var approxBytes = Math.round((dataUrl.length - 23) * 0.75);

      while (approxBytes > maxBytes && q > minQ) {
        q = Math.round((q - 0.03) * 100) / 100;
        dataUrl = canvas.toDataURL('image/jpeg', q);
        approxBytes = Math.round((dataUrl.length - 23) * 0.75);
      }
      return {
        dataUrl: dataUrl,
        sizeKb: Math.max(1, Math.round(approxBytes / 1024)),
        qualityPct: Math.round(q * 100)
      };
    }

