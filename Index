    // GOOGLE MAPS ROADMAP MINIMAP STITCHER (Complete with Street Names & POI Icons like Google Maps)
    function lon2tileFloat(lon, zoom) { return ((lon + 180) / 360) * Math.pow(2, zoom); }
    function lat2tileFloat(lat, zoom) {
      var rad = lat * Math.PI / 180;
      return ((1 - Math.log(Math.tan(rad) + 1 / Math.cos(rad)) / Math.PI) / 2) * Math.pow(2, zoom);
    }

    function updateMinimapTile(lat, lng) {
      var z = 17; // Zoom 17 shows detailed street names, schools, shops & POI icons
      var xf = lon2tileFloat(lng, z);
      var yf = lat2tileFloat(lat, z);
      var centerTileX = Math.floor(xf);
      var centerTileY = Math.floor(yf);
      var fracX = xf - centerTileX;
      var fracY = yf - centerTileY;

      var mCtx = minimapCanvas.getContext('2d');
      var cw = minimapCanvas.width;
      var ch = minimapCanvas.height;
      var tileSz = 256;

      // Center exact (lat, lng) at (cw/2, ch/2)
      var originX = Math.round((cw / 2) - (fracX * tileSz));
      var originY = Math.round((ch / 2) - (fracY * tileSz));

      for (var dx = -1; dx <= 1; dx++) {
        for (var dy = -1; dy <= 1; dy++) {
          (function(tx, ty, drawX, drawY) {
            var img = new Image();
            img.crossOrigin = 'anonymous';
            img.onload = function() {
              mCtx.drawImage(img, drawX, drawY, tileSz, tileSz);
              minimapReady = true;
              watermarkDirty = true;
              cacheCurrentMinimapTile();
            };
            img.onerror = function() {
              var fallback = new Image();
              fallback.crossOrigin = 'anonymous';
              fallback.onload = function() {
                mCtx.drawImage(fallback, drawX, drawY, tileSz, tileSz);
                minimapReady = true;
                watermarkDirty = true;
                cacheCurrentMinimapTile();
              };
              fallback.src = 'https://tile.openstreetmap.org/' + z + '/' + tx + '/' + ty + '.png';
            };
            // Google Maps Standard Roadmap with Indonesian labels & high-res scale=2
            img.src = 'https://mt1.google.com/vt/lyrs=m&hl=id&scale=2&x=' + tx + '&y=' + ty + '&z=' + z;
          })(centerTileX + dx, centerTileY + dy, originX + (dx * tileSz), originY + (dy * tileSz));
        }
      }
    }

