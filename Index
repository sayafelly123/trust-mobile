      var baseDate = appState.liveClock ? new Date() : new Date(appState.manualDate + 'T' + appState.manualTime);
      if (isNaN(baseDate.getTime())) baseDate = new Date();

      var idx = 0;
      function processNext() {
        if (idx >= batchFilesQueue.length) {
          btn.disabled = false;
          btn.innerHTML = origHtml;
          if (window.lucide) window.lucide.createIcons();
          showToast('Batch selesai: ' + batchFilesQueue.length + ' foto berhasil di-stamp!');
