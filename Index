          if (navigator.onLine === false) {
            enqueueOfflineDriveUpload(drivePayload);
          } else {
            callBackend('savePhotoRecord', drivePayload, function() {}, function() {
              enqueueOfflineDriveUpload(drivePayload);
            });
          }
        }
      });

      if (appState.autoSaveLocal !== false) {
        triggerJpegBlobDownload(snapJpeg, fileName);
      }

      syncFloatingWindowUI();

      // Only open modal pop-up if user explicitly enabled "Pop-up" in Floating Window; otherwise fast-shoot!
