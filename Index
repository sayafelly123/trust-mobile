            leafletMarker.setLatLng(ev.latlng);
            onLeafletPinMoved(ev.latlng.lat, ev.latlng.lng);
          });
        } else {
          leafletMap.invalidateSize();
          leafletMap.setView([appState.lat, appState.lng], 17);
          leafletMarker.setLatLng([appState.lat, appState.lng]);
        }
      }, 120);
    }

