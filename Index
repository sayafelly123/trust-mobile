      window.addEventListener('popstate', function() {
        var stepResult = handleBackNavigationStep();
        if (stepResult !== 'root_camera') {
          pushBackGuardState();
          return;
        }
        var now = Date.now();
        if (now - lastBackPressTime < 2200) {
          window.history.back();
        } else {
          lastBackPressTime = now;
          pushBackGuardState();
          showToast('Tekan tombol Kembali sekali lagi untuk keluar aplikasi');
        }
      });
    }

    // AUTO-ROTATE PORTRAIT <-> LANDSCAPE SENSOR (GRAVITY ACCELEROMETER + SCREEN ORIENTATION + MANUAL)
    function isMobileSensorDevice() {
      return window.innerWidth < 1024 && ('ontouchstart' in window || navigator.maxTouchPoints > 0);
    }

    function initAutoRotateListener() {
      function checkScreenOrientation() {
        if (orientationLockMode !== 'auto') return;
        // On Desktop/Laptop (Web Advance), keep Portrait (720x960) by default so preview matches HP screen 100%
        if (!isMobileSensorDevice() || appState.viewMode === 'webadmin') {
          applyCanvasOrientation(false);
          return;
        }
        var isLand = window.innerWidth > window.innerHeight;
        if (window.screen && window.screen.orientation && window.screen.orientation.type) {
          if (window.screen.orientation.type.indexOf('landscape') !== -1) isLand = true;
        }
        applyCanvasOrientation(isLand);
      }

      window.addEventListener('resize', checkScreenOrientation);
      window.addEventListener('orientationchange', function() {
        setTimeout(checkScreenOrientation, 150);
      });

      // Physical gravity sensor detects phone held in Landscape even when Android Auto-Rotate is locked!
      window.addEventListener('devicemotion', function(e) {
        if (orientationLockMode !== 'auto') return;
        var acc = e.accelerationIncludingGravity;
        if (!acc || acc.x === null || acc.y === null) return;
        var ax = acc.x;
        var ay = acc.y;
        if (Math.abs(ax) > 5.8 && Math.abs(ax) > Math.abs(ay) * 1.35) {
          physicalLandscapeDir = ax > 0 ? 'left' : 'right';
          if (!isLandscapeCanvas) applyCanvasOrientation(true);
        } else if (Math.abs(ay) > 5.8 && Math.abs(ay) > Math.abs(ax) * 1.35) {
          if (isLandscapeCanvas && window.innerWidth < window.innerHeight) {
            applyCanvasOrientation(false);
          }
        }
      });

      window.addEventListener('deviceorientation', function(e) {
        if (orientationLockMode !== 'auto') return;
        if (e.gamma !== null && e.beta !== null) {
          if (Math.abs(e.gamma) > 52 && Math.abs(e.beta) < 45) {
            physicalLandscapeDir = e.gamma < 0 ? 'left' : 'right';
            if (!isLandscapeCanvas) applyCanvasOrientation(true);
          } else if (Math.abs(e.beta) > 52 && Math.abs(e.gamma) < 35) {
            if (isLandscapeCanvas && window.innerWidth < window.innerHeight) {
              applyCanvasOrientation(false);
            }
          }
        }
      });

      checkScreenOrientation();
    }

    function toggleOrientationMode() {
      if (orientationLockMode === 'auto') {
        orientationLockMode = isLandscapeCanvas ? 'portrait' : 'landscape';
      } else if (orientationLockMode === 'landscape') {
        orientationLockMode = 'portrait';
      } else {
        orientationLockMode = 'auto';
