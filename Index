    // API HELPER (Fetch POST to Kode.gs)
    function callBackend(action, payload, onSuccess, onError) {
      fetch(SCRIPT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify({ action: action, payload: payload || {} })
      })
      .then(function(r) { return r.text(); })
      .then(function(text) {
        try {
          var res = JSON.parse(text);
          if (res.ok) {
            if (onSuccess) onSuccess(res.data);
          } else {
            showToast('Galat Server: ' + (res.message || 'Tidak diketahui'));
            if (onError) onError(res.message);
          }
        } catch (err) {
          showToast('Gagal membaca respon server');
          if (onError) onError(err.message);
        }
      })
      .catch(function(err) {
        updateNetworkBadge();
        if (action === 'getPresets' || action === 'getPhotosHistory') {
          if (onError) onError(err.message);
          return;
        }
        showToast('Mode Offline: Data disimpan di memori lokal HP');
        if (onError) onError(err.message);
      });
    }

    // OFFLINE-FIRST RESILIENCE & ANDROID NATIVE INDEXEDDB STORAGE (UNLIMITED CAPACITY)
    var LOCAL_HISTORY_KEY = 'trustmark_local_photos_v1';
    var OFFLINE_QUEUE_KEY = 'trustmark_offline_drive_queue_v1';
    var MINIMAP_CACHE_KEY = 'trustmark_minimap_cache_v1';
    var NATIVE_IDB_NAME = 'TrustMarkNativeDB';
    var NATIVE_IDB_STORE = 'localPhotos';
    var nativeIdbConn = null;
    var cachedLocalPhotosMem = [];
    var screenWakeLockSentinel = null;

    function openNativeIndexedDB(callback) {
      if (nativeIdbConn) {
        callback(nativeIdbConn);
        return;
      }
      if (!window.indexedDB) {
        callback(null);
        return;
      }
      try {
        var req = window.indexedDB.open(NATIVE_IDB_NAME, 1);
        req.onupgradeneeded = function(ev) {
          var db = ev.target.result;
          if (!db.objectStoreNames.contains(NATIVE_IDB_STORE)) {
            db.createObjectStore(NATIVE_IDB_STORE, { keyPath: 'id' });
          }
        };
        req.onsuccess = function(ev) {
          nativeIdbConn = ev.target.result;
          callback(nativeIdbConn);
        };
        req.onerror = function() {
          callback(null);
        };
      } catch (e) {
        callback(null);
      }
    }

    function syncAllPhotosFromIndexedDB() {
      openNativeIndexedDB(function(db) {
        if (!db) {
          renderLocalOfflineHistory();
          return;
        }
        try {
          var tx = db.transaction([NATIVE_IDB_STORE], 'readonly');
          var store = tx.objectStore(NATIVE_IDB_STORE);
          var getAllReq = store.getAll();
          getAllReq.onsuccess = function() {
            var rows = getAllReq.result || [];
            rows.sort(function(a, b) {
              return String(b.id || '').localeCompare(String(a.id || ''));
            });
            cachedLocalPhotosMem = rows;
            renderLocalOfflineHistory();
          };
        } catch (e) {
          renderLocalOfflineHistory();
        }
      });
    }

