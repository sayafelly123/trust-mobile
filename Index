    function onPrecisionSliderInput() {
      var key = document.getElementById('selTargetElement').value || 'textBlock';
      var xPct = parseFloat(document.getElementById('rngPosX').value) || 0;
      var yPct = parseFloat(document.getElementById('rngPosY').value) || 0;
      var ref = getTargetPositionRef(key);
      if (key.indexOf('sub_') === 0) {
        ref.rx = xPct / 100;
        ref.ry = yPct / 100;
      } else {
        ref.rx = Math.max(0.015, Math.min(0.985, xPct / 100));
        ref.ry = Math.max(0.015, Math.min(0.985, yPct / 100));
      }
      watermarkDirty = true;
      syncPrecisionSlidersFromElement();
      saveState();
    }

