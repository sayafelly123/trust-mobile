    function flushOfflineDriveQueue(showNotif) {
      var q = getOfflineDriveQueue();
      var lblQ = document.getElementById('lblOfflineQueueCount');
      if (lblQ) lblQ.textContent = String(q.length);
      if (!q.length) {
        if (showNotif) showToast('Tidak ada antrean foto offline');
        return;
      }
      if (navigator.onLine === false) {
        if (showNotif) showToast('Masih Offline. Antrean akan diupload saat sinyal kembali.');
        return;
      }
      var item = q[0];
      callBackend('savePhotoRecord', item, function() {
        var currentQ = getOfflineDriveQueue();
        currentQ.shift();
        localStorage.setItem(OFFLINE_QUEUE_KEY, JSON.stringify(currentQ));
        renderLocalOfflineHistory();
        if (currentQ.length > 0) {
          setTimeout(function() { flushOfflineDriveQueue(showNotif); }, 300);
        } else {
          showToast('Semua antrean foto offline berhasil di-upload ke Google Drive!');
          if (appState.viewMode === 'history') loadCloudHistory();
        }
      }, function() {});
    }

