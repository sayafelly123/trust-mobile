    // ============================================================================
    // UNIFIED WATERMARK RENDERING ENGINE (drawUnifiedWatermark)
    // ============================================================================
    function formatIndonesianDateObject(dateStr, timeStr, useLiveClock) {
      var d = useLiveClock ? new Date() : new Date(dateStr + 'T' + (timeStr || '09:00:00'));
      if (isNaN(d.getTime())) d = new Date();
      var dayName = ID_DAYS[d.getDay()];
      var dayNum = String(d.getDate()).padStart(2, '0');
      var monthName = ID_MONTHS[d.getMonth()];
      var yearNum = d.getFullYear();
      var hh = String(d.getHours()).padStart(2, '0');
      var mm = String(d.getMinutes()).padStart(2, '0');
      var ss = String(d.getSeconds()).padStart(2, '0');
      return {
        timeHM: hh + ':' + mm,
        timeHMS: hh + ':' + mm + ':' + ss,
        dayName: dayName,
        dateFormatted: dayNum + ' ' + monthName + ' ' + yearNum,
        exifDateStr: yearNum + ':' + String(d.getMonth() + 1).padStart(2, '0') + ':' + dayNum + ' ' + hh + ':' + mm + ':' + ss
      };
    }

    function wrapCanvasText(ctx, text, maxWidth) {
      var words = String(text || '').split(' ');
      var lines = [];
      var current = '';
      for (var i = 0; i < words.length; i++) {
        var testLine = current ? (current + ' ' + words[i]) : words[i];
        if (ctx.measureText(testLine).width > maxWidth && current) {
          lines.push(current);
          current = words[i];
        } else {
          current = testLine;
        }
      }
      if (current) lines.push(current);
      return lines;
    }

    function drawRoundedRect(ctx, x, y, w, h, r) {
      ctx.beginPath();
      ctx.moveTo(x + r, y);
      ctx.lineTo(x + w - r, y);
      ctx.quadraticCurveTo(x + w, y, x + w, y + r);
      ctx.lineTo(x + w, y + h - r);
      ctx.quadraticCurveTo(x + w, y + h, x + w - r, y + h);
      ctx.lineTo(x + r, y + h);
      ctx.quadraticCurveTo(x, y + h, x, y + h - r);
      ctx.lineTo(x, y + r);
      ctx.quadraticCurveTo(x, y, x + r, y);
      ctx.closePath();
    }

    function drawStrokedText(ctx, text, x, y, fillStyle, strokeWidth) {
      if (strokeWidth > 0) {
        ctx.save();
        ctx.lineJoin = 'round';
        ctx.lineWidth = strokeWidth;
        ctx.strokeStyle = 'rgba(0,0,0,0.82)';
        ctx.strokeText(text, x, y);
        ctx.restore();
      }
      ctx.fillStyle = fillStyle;
      ctx.fillText(text, x, y);
    }

    function drawVectorShieldIcon(ctx, x, y, size, navyColor, accentColor) {
      ctx.save();
      ctx.translate(x, y);
      var s = size / 24;
      ctx.scale(s, s);
      ctx.beginPath();
      ctx.moveTo(12, 2);
      ctx.lineTo(20, 5.5);
      ctx.lineTo(20, 11.5);
      ctx.bezierCurveTo(20, 16.8, 16.5, 20.8, 12, 22.5);
      ctx.bezierCurveTo(7.5, 20.8, 4, 16.8, 4, 11.5);
      ctx.lineTo(4, 5.5);
      ctx.closePath();
      ctx.fillStyle = navyColor || '#15335d';
      ctx.fill();
      ctx.lineWidth = 1.6;
      ctx.strokeStyle = '#ffffff';
      ctx.stroke();

      ctx.beginPath();
      ctx.moveTo(8.5, 12.2);
      ctx.lineTo(11, 14.8);
      ctx.lineTo(16, 9.5);
      ctx.strokeStyle = accentColor || '#f97316';
      ctx.lineWidth = 2.6;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.stroke();
      ctx.restore();
    }

    function drawLogoPlaqueAndImage(ctx, x, y, w, h, plaqueType, imgObj, fallbackLabel) {
      var boxW = w;
      var boxH = h || w;
      var minDim = Math.min(boxW, boxH);
      ctx.save();
      if (plaqueType === 'white') {
        drawRoundedRect(ctx, x, y, boxW, boxH, 14);
        ctx.fillStyle = 'rgba(255,255,255,0.94)';
        ctx.fill();
        ctx.lineWidth = 2;
        ctx.strokeStyle = 'rgba(15,23,42,0.25)';
        ctx.stroke();
      } else if (plaqueType === 'glass') {
        drawRoundedRect(ctx, x, y, boxW, boxH, 14);
        ctx.fillStyle = 'rgba(15,23,42,0.68)';
        ctx.fill();
        ctx.lineWidth = 1.5;
        ctx.strokeStyle = 'rgba(255,255,255,0.28)';
        ctx.stroke();
      } else if (plaqueType === 'circle') {
        ctx.beginPath();
        if (ctx.ellipse) {
          ctx.ellipse(x + boxW / 2, y + boxH / 2, boxW / 2, boxH / 2, 0, 0, Math.PI * 2);
        } else {
          ctx.arc(x + boxW / 2, y + boxH / 2, minDim / 2, 0, Math.PI * 2);
        }
        ctx.fillStyle = 'rgba(255,255,255,0.94)';
        ctx.fill();
      }

      if (imgObj && imgObj.complete && imgObj.naturalWidth > 0) {
        var padX = plaqueType === 'transparent' ? 0 : Math.round(boxW * 0.10);
        var padY = plaqueType === 'transparent' ? 0 : Math.round(boxH * 0.10);
        ctx.drawImage(imgObj, x + padX, y + padY, boxW - padX * 2, boxH - padY * 2);
      } else {
        drawVectorShieldIcon(ctx, x + (boxW - minDim * 0.64) / 2, y + boxH * 0.14, minDim * 0.64, '#15335d', '#f59e0b');
        ctx.font = '700 ' + Math.round(minDim * 0.14) + 'px Inter, sans-serif';
        ctx.fillStyle = plaqueType === 'white' || plaqueType === 'circle' ? '#0f172a' : '#ffffff';
        ctx.textAlign = 'center';
        ctx.fillText(fallbackLabel, x + boxW / 2, y + boxH - 6);
      }
      ctx.restore();
    }

    function drawSourceFrameOrGrid(ctx, w, h, sourceImgOrVideo, highQuality) {
      ctx.save();
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = highQuality ? 'high' : 'low';
      var hasSource = false;
      if (sourceImgOrVideo) {
        var sw = sourceImgOrVideo.videoWidth || sourceImgOrVideo.naturalWidth || sourceImgOrVideo.width || 0;
        var sh = sourceImgOrVideo.videoHeight || sourceImgOrVideo.naturalHeight || sourceImgOrVideo.height || 0;
        if (sw > 0 && sh > 0) {
          hasSource = true;
          var scaleCover = Math.max(w / sw, h / sh);
          var dw = sw * scaleCover;
          var dh = sh * scaleCover;
          ctx.drawImage(sourceImgOrVideo, (w - dw) / 2, (h - dh) / 2, dw, dh);
        }
      }
      if (!hasSource) {
        var grad = ctx.createLinearGradient(0, 0, w, h);
        grad.addColorStop(0, '#1e293b');
        grad.addColorStop(0.5, '#0f172a');
        grad.addColorStop(1, '#111827');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, w, h);
        ctx.strokeStyle = 'rgba(255,255,255,0.05)';
        ctx.lineWidth = 2;
        for (var gx = 0; gx < w; gx += 90) { ctx.beginPath(); ctx.moveTo(gx, 0); ctx.lineTo(gx, h); ctx.stroke(); }
        for (var gy = 0; gy < h; gy += 90) { ctx.beginPath(); ctx.moveTo(0, gy); ctx.lineTo(w, gy); ctx.stroke(); }
      }
      ctx.restore();
    }

    function drawUnifiedWatermark(ctx, w, h, sourceImgOrVideo, state, customClockObj, customCoords, customPhotoCode, forceDirectWatermark, overlayOnlyMode) {
      ctx.save();
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = forceDirectWatermark ? 'high' : 'medium';
      ctx.clearRect(0, 0, w, h);

      // 1. DRAW PHOTO OR CAMERA VIDEO FRAME (Unless rendering cached transparent overlay layer)
      if (!overlayOnlyMode) {
        drawSourceFrameOrGrid(ctx, w, h, sourceImgOrVideo, Boolean(forceDirectWatermark));
      }

      // Rotate watermark coordinate system 90° when phone is held in Landscape while viewport is Portrait
      var stageW = w;
      var stageH = h;
      if (!forceDirectWatermark && isPortraitViewportWithLandscapeTilt() && w < h) {
        stageW = h;
        stageH = w;
        if (physicalLandscapeDir === 'right') {
          ctx.translate(0, h);
          ctx.rotate(-Math.PI / 2);
        } else {
          ctx.translate(w, 0);
          ctx.rotate(Math.PI / 2);
        }
      }

      // Subtle Bottom Gradient Vignette for Readability
      var botGrad = ctx.createLinearGradient(0, stageH * 0.60, 0, stageH);
      botGrad.addColorStop(0, 'rgba(0,0,0,0)');
      botGrad.addColorStop(1, 'rgba(0,0,0,0.68)');
      ctx.fillStyle = botGrad;
      ctx.fillRect(0, stageH * 0.60, stageW, stageH * 0.40);

      var resScale = Math.min(stageW, stageH) / 1080;
      var sFactor = ((state.scale || 100) / 100) * resScale;
      var clk = customClockObj || formatIndonesianDateObject(state.manualDate, state.manualTime, state.liveClock);
      var coords = customCoords || { lat: state.lat, lng: state.lng };
      var pCode = customPhotoCode || state.photoCode || state.serialCode;
      var clockFontFamily = '"' + (state.clockFont || 'Inter') + '", Inter, sans-serif';
      var addrFontFamily = '"' + (state.addrFont || 'Inter') + '", Inter, sans-serif';

      // SAFE EDGE MARGIN (BATASAN MINIMAL TEPI 1.5% PROPORSIONAL PORTRAIT & LANDSCAPE)
      var minMarginRatio = Math.max(0.015, (Number(state.edgeMarginPct) || 1.5) / 100);
      var padEdge = Math.max(Math.round(16 * sFactor), Math.round(Math.min(stageW, stageH) * minMarginRatio));
      var padRightSafe = pCode ? (padEdge + Math.round(22 * sFactor)) : padEdge;

      // Visual Safe Margin Guide Frame when user is dragging an element
      if (!forceDirectWatermark && activeDragKey) {
        ctx.save();
        ctx.strokeStyle = 'rgba(245, 158, 11, 0.55)';
        ctx.lineWidth = 2;
        ctx.setLineDash([8, 6]);
        ctx.strokeRect(padEdge, padEdge, stageW - padEdge - padRightSafe, stageH - padEdge * 2);
        ctx.restore();
      }

      // Helper to read individual sub-element pixel offset (default 0,0 when rx=0.5, ry=0.5)
      function getSubPx(subKey) {
        var so = (state.subOffsets && state.subOffsets[subKey]) ? state.subOffsets[subKey] : { rx: 0.50, ry: 0.50 };
        return {
          dx: Math.round((so.rx - 0.50) * 600 * sFactor),
          dy: Math.round((so.ry - 0.50) * 600 * sFactor)
        };
      }

      // Pre-calculate Text Block & Minimap bounds with individual component scales
      var mapS = sFactor * ((state.minimapScale || 100) / 100);
      var mapW = Math.round(210 * mapS);
      var mapH = Math.round(210 * mapS);
      var mx = Math.max(padEdge, Math.min(stageW - mapW - padRightSafe, Math.round(state.positions.minimap.rx * stageW)));
      var my = Math.max(padEdge, Math.min(stageH - mapH - padEdge, Math.round(state.positions.minimap.ry * stageH)));
      if (state.positions.minimap.rx <= 0.045) mx = padEdge;
      if (state.positions.minimap.ry <= 0.045) my = padEdge;

      var bScale = sFactor * ((state.brandScale || 100) / 100);
      var icon3W = Math.round((state.logo3Width || 44) * bScale);
      var icon3H = Math.round((state.logo3Height || 44) * bScale);
      var brandBoxW = icon3W + Math.round(186 * bScale);
      var brandBoxH = Math.max(icon3H, Math.round(52 * bScale));
      var reserveRightForBrand = (state.logo3Enabled && state.positions.logo3.ry >= 0.65 && state.positions.textBlock.ry >= 0.55)
        ? (brandBoxW + Math.round(20 * sFactor))
        : 0;

      var maxAllowedAddrW = Math.max(Math.round(300 * sFactor), stageW - padEdge - padRightSafe - reserveRightForBrand);
      var maxAddrW = Math.min(maxAllowedAddrW, Math.round((state.addrWidth || 520) * sFactor));
      var baseClockPx = Math.round((state.clockFontSize || 72) * sFactor);
      var baseAddrPx = Math.round((state.addrFontSize || 21) * sFactor);
      var ddScale = (state.dateDayScale || 100) / 100;
      var mScale = (state.metaScale || 100) / 100;

      ctx.font = '500 ' + baseAddrPx + 'px ' + addrFontFamily;
      var addrLines = wrapCanvasText(ctx, state.address, maxAddrW);
      var lineH = Math.round(baseAddrPx * 1.34);
      var metaPx = Math.max(11, Math.round(baseAddrPx * 0.90 * mScale));
      var metaLineH = Math.round(metaPx * 1.42);
      var headerH = Math.round(Math.max(baseClockPx, baseClockPx * 0.78 * ddScale) * 1.05);
      var extraRows = 2 + (state.note ? 1 : 0) + (state.company ? 1 : 0);
      var totalBlockH = headerH + (addrLines.length * lineH) + (extraRows * metaLineH) + Math.round(16 * sFactor);

      var tx = Math.max(padEdge, Math.min(stageW - maxAddrW - padRightSafe, Math.round(state.positions.textBlock.rx * stageW)));
      var ty = Math.max(padEdge, Math.min(stageH - totalBlockH - padEdge, Math.round(state.positions.textBlock.ry * stageH)));
      // Smart Corner Snap: if marking is in Bottom-Left zone, align left & bottom neatly to 1.5% padEdge in both Portrait & Landscape
      if (state.positions.textBlock.rx <= 0.045) tx = padEdge;
      if (state.positions.textBlock.ry >= 0.58) ty = stageH - totalBlockH - padEdge;

      // 2. GOOGLE MAPS ROADMAP MINI MAP (Top-Left default, shows street names & POIs + fan radar cone)
      if (state.showMinimap) {

        ctx.save();
        drawRoundedRect(ctx, mx, my, mapW, mapH, Math.round(22 * mapS));
        ctx.fillStyle = '#e5e7eb';
        ctx.fill();
        ctx.clip();

        var panDx = (coords && typeof coords.panDx === 'number') ? coords.panDx : 0;
        var panDy = (coords && typeof coords.panDy === 'number') ? coords.panDy : 0;
        if (!panDx && !panDy && coords && (coords.lat !== state.lat || coords.lng !== state.lng)) {
          panDx = Math.max(-16, Math.min(16, Math.round((coords.lng - state.lng) * 550000)));
          panDy = Math.max(-16, Math.min(16, Math.round(-(coords.lat - state.lat) * 550000)));
        }

        if (minimapReady) {
          var cropSz = 220;
          var sxCrop = Math.max(0, Math.min(minimapCanvas.width - cropSz, Math.round((minimapCanvas.width - cropSz) / 2) + panDx));
          var syCrop = Math.max(0, Math.min(minimapCanvas.height - cropSz, Math.round((minimapCanvas.height - cropSz) / 2) + panDy));
          ctx.drawImage(minimapCanvas, sxCrop, syCrop, cropSz, cropSz, mx, my, mapW, mapH);
        } else {
          ctx.fillStyle = '#e2e8f0';
          ctx.fillRect(mx, my, mapW, mapH);
        }

        // Green Directional Radar Sector Cone (Subtly shifts with 1-2m map movement)
        var cx = mx + (mapW / 2) - Math.round(panDx * 0.25 * mapS);
        var cy = my + (mapH * 0.45) - Math.round(panDy * 0.25 * mapS);
        var coneShift = (coords && typeof coords.coneShiftRad === 'number') ? coords.coneShiftRad : 0;
        var coneRadius = mapW * 0.34;
        ctx.beginPath();
        ctx.moveTo(cx, cy);
        ctx.arc(cx, cy, coneRadius, (Math.PI * 0.22) + coneShift, (Math.PI * 0.78) + coneShift);
        ctx.closePath();
        var coneGrad = ctx.createRadialGradient(cx, cy, 4, cx, cy, coneRadius);
        coneGrad.addColorStop(0, 'rgba(16, 185, 129, 0.62)');
        coneGrad.addColorStop(1, 'rgba(52, 211, 153, 0.25)');
        ctx.fillStyle = coneGrad;
        ctx.fill();

        // Blue Google Maps Location Pin in Center with White Inner Dot
        ctx.beginPath();
        ctx.arc(cx, cy, 9 * mapS, 0, Math.PI * 2);
        ctx.fillStyle = '#1d4ed8';
        ctx.fill();
        ctx.lineWidth = Math.max(1.5, 2.5 * mapS);
        ctx.strokeStyle = '#ffffff';
        ctx.stroke();

        ctx.beginPath();
        ctx.arc(cx, cy, 3 * mapS, 0, Math.PI * 2);
        ctx.fillStyle = '#ffffff';
        ctx.fill();

        // Colorful "Google" Logo bottom-left of minimap
        var gFont = Math.max(10, Math.round(16 * mapS));
        ctx.font = '700 ' + gFont + 'px Inter, sans-serif';
        var gLetters = [
          { c: 'G', col: '#4285F4' },
          { c: 'o', col: '#EA4335' },
          { c: 'o', col: '#FBBC05' },
          { c: 'g', col: '#4285F4' },
          { c: 'l', col: '#34A853' },
          { c: 'e', col: '#EA4335' }
        ];
        var gxCur = mx + Math.round(12 * mapS);
        var gyCur = my + mapH - Math.round(12 * mapS);
        for (var gi = 0; gi < gLetters.length; gi++) {
          ctx.save();
          ctx.lineWidth = Math.max(2, 3 * mapS);
          ctx.strokeStyle = 'rgba(255,255,255,0.92)';
          ctx.strokeText(gLetters[gi].c, gxCur, gyCur);
          ctx.fillStyle = gLetters[gi].col;
          ctx.fillText(gLetters[gi].c, gxCur, gyCur);
          ctx.restore();
          gxCur += ctx.measureText(gLetters[gi].c).width;
        }
        ctx.restore();
      }

      // 3. LOGO 1 & LOGO 2 (Deterministic Anchor Lock for 100% Portrait & Landscape Consistency)
      var l1W = Math.round((state.logo1Size || 130) * sFactor);
      var l1H = Math.round((state.logo1Height || state.logo1Size || 130) * sFactor);
      var l1Anchor = state.logo1Anchor || 'top-right';
      var l1x = padEdge;
      var l1y = padEdge;

      if (l1Anchor === 'top-right') {
        l1x = stageW - l1W - padRightSafe;
        l1y = padEdge;
      } else if (l1Anchor === 'above-clock-left') {
        l1x = padEdge;
        l1y = ty - l1H - Math.round(12 * sFactor);
        if (state.showMinimap && l1y < my + mapH + Math.round(8 * sFactor)) {
          // If Landscape height is tight between Minimap & Clock, place neatly to the right of Minimap
          l1x = mx + mapW + Math.round(12 * sFactor);
          l1y = padEdge;
        }
      } else if (l1Anchor === 'below-minimap-left') {
        l1x = padEdge;
        l1y = state.showMinimap ? (my + mapH + Math.round(12 * sFactor)) : padEdge;
        if (l1y + l1H > ty - Math.round(8 * sFactor)) {
          l1x = mx + mapW + Math.round(12 * sFactor);
          l1y = padEdge;
        }
      } else if (l1Anchor === 'top-left') {
        l1x = padEdge;
        l1y = padEdge;
      } else {
        l1x = Math.max(padEdge, Math.min(stageW - l1W - padRightSafe, Math.round(state.positions.logo1.rx * stageW)));
        l1y = Math.max(padEdge, Math.min(stageH - l1H - padEdge, Math.round(state.positions.logo1.ry * stageH)));
        if (state.positions.logo1.rx <= 0.05) l1x = padEdge;
        if (state.positions.logo1.rx >= 0.74) l1x = stageW - l1W - padRightSafe;
        if (state.positions.logo1.ry <= 0.06) l1y = padEdge;
      }
      l1x = Math.max(padEdge, Math.min(stageW - l1W - padRightSafe, l1x));
      l1y = Math.max(padEdge, Math.min(stageH - l1H - padEdge, l1y));
      if (state.logo1Enabled) {
        drawLogoPlaqueAndImage(ctx, l1x, l1y, l1W, l1H, state.logo1Plaque, logoImgs[1], 'LOGO 1');
      }

      if (state.logo2Enabled) {
        var l2W = Math.round((state.logo2Size || 76) * sFactor);
        var l2H = Math.round((state.logo2Height || state.logo2Size || 76) * sFactor);
        var l2Anchor = state.logo2Anchor || 'top-right-beside';
        var l2x = stageW - l2W - padRightSafe;
        var l2y = padEdge;

        if (l2Anchor === 'top-right-beside') {
          if (state.logo1Enabled && l1Anchor === 'top-right') {
            l2x = l1x - l2W - Math.round(10 * sFactor);
            l2y = padEdge;
          } else {
            l2x = stageW - l2W - padRightSafe;
            l2y = padEdge;
          }
        } else if (l2Anchor === 'top-right') {
          l2x = stageW - l2W - padRightSafe;
          l2y = padEdge;
        } else if (l2Anchor === 'above-clock-left') {
          l2x = padEdge;
          l2y = ty - l2H - Math.round(12 * sFactor);
        } else if (l2Anchor === 'below-minimap-left') {
          l2x = padEdge;
          l2y = state.showMinimap ? (my + mapH + Math.round(12 * sFactor)) : padEdge;
        } else {
          l2x = Math.max(padEdge, Math.min(stageW - l2W - padRightSafe, Math.round(state.positions.logo2.rx * stageW)));
          l2y = Math.max(padEdge, Math.min(stageH - l2H - padEdge, Math.round(state.positions.logo2.ry * stageH)));
          if (state.positions.logo2.rx <= 0.05) l2x = padEdge;
          if (state.positions.logo2.rx >= 0.74) l2x = stageW - l2W - padRightSafe;
          if (state.positions.logo2.ry <= 0.06) l2y = padEdge;
        }
        l2x = Math.max(padEdge, Math.min(stageW - l2W - padRightSafe, l2x));
        l2y = Math.max(padEdge, Math.min(stageH - l2H - padEdge, l2y));
        drawLogoPlaqueAndImage(ctx, l2x, l2y, l2W, l2H, state.logo2Plaque, logoImgs[2], 'LOGO 2');
      }

      // 4. VERTICAL SERIAL CODE ON RIGHT EDGE WITH STARTING SHIELD SYMBOL + CLOSING PHRASE ("TrustMark Verified")
      if (pCode) {
        var serS = sFactor * ((state.serialScale || 100) / 100);
        var rightOffset = Math.round((1 - Math.min(0.992, Math.max(0.75, state.positions.serial.rx || 0.985))) * stageW);
        var sx = stageW - Math.max(Math.round(padEdge * 0.55), rightOffset);
        var sy = Math.max(padEdge + 120, Math.min(stageH - padEdge - 120, Math.round((state.positions.serial.ry || 0.48) * stageH)));
        var suffixStr = state.serialSuffix !== undefined ? state.serialSuffix : 'TrustMark Verified';
        var fullVertText = pCode + (suffixStr ? ('  ' + suffixStr) : '');

        ctx.save();
        ctx.translate(sx, sy);
        ctx.rotate(-Math.PI / 2);
        ctx.textAlign = 'left';
        ctx.textBaseline = 'middle';
        var vFontPx = Math.max(10, Math.round(15 * serS));
        ctx.font = '600 ' + vFontPx + 'px ' + addrFontFamily;
        var textWidthVert = ctx.measureText(fullVertText).width;
        var iconVertSz = Math.max(11, Math.round(16 * serS));
        var totalVertW = iconVertSz + 6 + textWidthVert;
        var startVertX = -Math.round(totalVertW / 2);

        // Draw small circular shield check symbol at the beginning of vertical text
        ctx.beginPath();
        ctx.arc(startVertX + iconVertSz / 2, 0, iconVertSz * 0.46, 0, Math.PI * 2);
        ctx.fillStyle = 'rgba(255,255,255,0.92)';
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(startVertX + iconVertSz * 0.28, 0);
        ctx.lineTo(startVertX + iconVertSz * 0.45, iconVertSz * 0.18);
        ctx.lineTo(startVertX + iconVertSz * 0.74, -iconVertSz * 0.18);
        ctx.strokeStyle = '#0f172a';
        ctx.lineWidth = 2;
        ctx.stroke();

        drawStrokedText(ctx, fullVertText, startVertX + iconVertSz + 6, 0, state.textColor, Math.max(1, state.strokeWidth - 1));
        ctx.restore();
      }

      // 5. LOGO 3 / BRAND TRUSTMARK VECTOR (Bottom Right — Custom Width/Height & Brand Scale)
      if (state.logo3Enabled) {
        var b3x = Math.max(padEdge, Math.min(stageW - brandBoxW - padRightSafe, Math.round(state.positions.logo3.rx * stageW)));
        var b3y = Math.max(padEdge, Math.min(stageH - brandBoxH - padEdge, Math.round(state.positions.logo3.ry * stageH)));
        if (state.positions.logo3.rx >= 0.72) b3x = stageW - brandBoxW - padRightSafe;
        if (state.positions.logo3.ry >= 0.80) b3y = stageH - brandBoxH - padEdge;
        ctx.save();
        if (logoImgs[3] && logoImgs[3].complete && logoImgs[3].naturalWidth > 0) {
          ctx.drawImage(logoImgs[3], b3x, b3y, icon3W, icon3H);
        } else {
          // Draw Reference Style Rounded Box Badge with Orange "T" and Dot
          drawRoundedRect(ctx, b3x, b3y, icon3W, icon3H, 10 * bScale);
          ctx.fillStyle = 'rgba(21, 51, 93, 0.25)';
          ctx.fill();
          ctx.lineWidth = 3.2 * bScale;
          ctx.strokeStyle = '#1e3a8a';
          ctx.stroke();

          ctx.font = '800 ' + Math.round(Math.min(icon3W, icon3H) * 0.58) + 'px Inter, sans-serif';
          ctx.fillStyle = '#f97316';
          ctx.textAlign = 'center';
          ctx.textBaseline = 'middle';
          ctx.fillText('T', b3x + icon3W * 0.44, b3y + icon3H * 0.54);

          ctx.beginPath();
          ctx.arc(b3x + icon3W * 0.72, b3y + icon3H * 0.68, 3.2 * bScale, 0, Math.PI * 2);
          ctx.fillStyle = '#1e3a8a';
          ctx.fill();
        }
        ctx.textAlign = 'left';
        ctx.textBaseline = 'alphabetic';
        var tx3 = b3x + icon3W + Math.round(10 * bScale);
        var bTitle = String(state.brandTitle || 'TrustMark');
        ctx.font = '800 ' + Math.round(23 * bScale) + 'px ' + addrFontFamily;
        if (bTitle.toLowerCase() === 'trustmark') {
          drawStrokedText(ctx, 'Trust', tx3, b3y + Math.round(icon3H * 0.48), '#1e3a8a', 1.5);
          var trustW = ctx.measureText('Trust').width;
          drawStrokedText(ctx, 'Mark', tx3 + trustW, b3y + Math.round(icon3H * 0.48), '#f97316', 1.5);
        } else {
          drawStrokedText(ctx, bTitle, tx3, b3y + Math.round(icon3H * 0.48), '#ffffff', state.strokeWidth);
        }
        ctx.font = '500 ' + Math.round(13.5 * bScale) + 'px ' + addrFontFamily;
        drawStrokedText(ctx, state.brandSub || 'Foto 100% terpercaya', tx3, b3y + Math.round(icon3H * 0.88), '#f8fafc', Math.max(1, state.strokeWidth - 1));
        ctx.restore();
      }

      // 6. MAIN TIMESTAMP & LOCATION BLOCK (Bottom Left, pre-clamped to Safe Edge Margin)
      ctx.save();
      if (state.textBg !== 'none') {
        drawRoundedRect(ctx, tx - 14, ty - 14, maxAddrW + 32, totalBlockH, 16);
        ctx.fillStyle = state.textBg === 'solid' ? 'rgba(15,23,42,0.9)' : 'rgba(15,23,42,0.55)';
        ctx.fill();
      }

      // 6A. Big Clock HH:mm (with individual offset sub_clock)
      var offClock = getSubPx('sub_clock');
      ctx.font = '700 ' + baseClockPx + 'px ' + clockFontFamily;
      var clockX = tx + offClock.dx;
      var clockY = ty + Math.round(baseClockPx * 0.84) + offClock.dy;
      drawStrokedText(ctx, clk.timeHM, clockX, clockY, state.textColor, state.strokeWidth);
      var clockW = ctx.measureText(clk.timeHM).width;

      // 6B. Vertical Divider Bar (with configurable height %, thickness px & individual offset sub_bar)
      var offBar = getSubPx('sub_bar');
      var barW = Math.max(2, Math.round((Number(state.barWidthPx) || 4.5) * sFactor));
      var barH = Math.max(10, Math.round(baseClockPx * ((Number(state.barHeightPct) || 78) / 100)));
      var barX = tx + clockW + Math.round(16 * sFactor) + offBar.dx;
      var barY = ty + Math.round((baseClockPx * 0.86 - barH) / 2) + offBar.dy;
      ctx.fillStyle = state.barColor || '#f59e0b';
      drawRoundedRect(ctx, barX, barY, barW, barH, Math.min(4, barW / 2));
      ctx.fill();

      // 6C. Date on Top ("23 Oktober 2026") & Day Name Below ("Jumat") with Date/Day Scale
      var offDate = getSubPx('sub_date');
      var offDay = getSubPx('sub_day');
      var dateBaseX = barX + barW + Math.round(14 * sFactor);
      var dateFontPx = Math.max(11, Math.round(baseClockPx * 0.31 * ddScale));
      var dayFontPx = Math.max(11, Math.round(baseClockPx * 0.31 * ddScale));

      ctx.font = '600 ' + dateFontPx + 'px ' + addrFontFamily;
      drawStrokedText(ctx, clk.dateFormatted, dateBaseX + offDate.dx, ty + Math.round(baseClockPx * 0.36) + offDate.dy, state.textColor, state.strokeWidth);

      ctx.font = '600 ' + dayFontPx + 'px ' + addrFontFamily;
      drawStrokedText(ctx, clk.dayName, dateBaseX + offDay.dx, ty + Math.round(baseClockPx * 0.78) + offDay.dy, state.textColor, state.strokeWidth);

      // 6D. Wrapped Address Lines (with individual offset sub_addr)
      var offAddr = getSubPx('sub_addr');
      var curY = ty + headerH + Math.round(14 * sFactor) + offAddr.dy;
      ctx.font = '500 ' + baseAddrPx + 'px ' + addrFontFamily;
      for (var i = 0; i < addrLines.length; i++) {
        drawStrokedText(ctx, addrLines[i], tx + offAddr.dx, curY, state.textColor, state.strokeWidth);
        curY += lineH;
      }

      // 6E. Koordinat Row inside Translucent Pill Badge (scaled by metaScale)
      var offCoord = getSubPx('sub_coord');
      ctx.font = '500 ' + metaPx + 'px ' + addrFontFamily;
      var latDir = coords.lat < 0 ? 'S' : 'N';
      var lngDir = coords.lng < 0 ? 'W' : 'E';
      var coordText = 'Koordinat: ' + Math.abs(coords.lat).toFixed(6) + '°' + latDir + ', ' + Math.abs(coords.lng).toFixed(6) + '°' + lngDir;
      var coordTextW = ctx.measureText(coordText).width;
      var pillX = tx + offCoord.dx;
      var pillY = curY - Math.round(metaPx * 0.88) + offCoord.dy;
      var pillH = Math.round(metaPx * 1.38);

      ctx.save();
      drawRoundedRect(ctx, pillX, pillY, coordTextW + 22, pillH, 6);
      ctx.fillStyle = 'rgba(15, 23, 42, 0.42)';
      ctx.fill();
      ctx.restore();

      drawStrokedText(ctx, coordText, pillX + 10, curY + offCoord.dy + 2, state.textColor, Math.max(1, state.strokeWidth - 1));
      curY += metaLineH + 4;

      // 6F. Company & Catatan Row (scaled by metaScale)
      var offComp = getSubPx('sub_company');
      ctx.font = '500 ' + metaPx + 'px ' + addrFontFamily;
      if (state.note) {
        drawStrokedText(ctx, 'Catatan: ' + state.note, tx + offComp.dx, curY + offComp.dy, state.textColor, state.strokeWidth);
        curY += metaLineH;
      }
      if (state.company) {
        drawStrokedText(ctx, 'Company: ' + state.company, tx + offComp.dx, curY + offComp.dy, state.textColor, state.strokeWidth);
        curY += metaLineH;
      }

      // 6G. Shield Vector + Kode Foto Row (scaled by metaScale)
      var offCode = getSubPx('sub_code');
      var shSz = Math.round(metaPx * 1.08);
      var codeRowX = tx + offCode.dx;
      var codeRowY = curY + offCode.dy;
      drawVectorShieldIcon(ctx, codeRowX, codeRowY - shSz + 3, shSz, '#3b82f6', '#ffffff');
      ctx.font = '500 ' + Math.max(11, Math.round(metaPx * 0.95)) + 'px ' + addrFontFamily;
      drawStrokedText(ctx, 'Kode Foto: ' + pCode, codeRowX + shSz + 8, codeRowY, 'rgba(226, 232, 240, 0.9)', Math.max(1, state.strokeWidth - 1));

      ctx.restore();
      ctx.restore();

      // 7. WHATSAPP-PROOF OPTICAL PIXEL STEGANOGRAPHY SEAL (Embedded directly into final photo pixels)
      if (!overlayOnlyMode && forceDirectWatermark) {
        drawTrustMarkOpticalSeal(ctx, w, h, clk, coords, pCode);
      }
    }

    // 60FPS HARDWARE-ACCELERATED LIVE RENDER LOOP (Cached Watermark Layer prevents CPU/GPU lag)
    function renderLoop() {
      var canvas = document.getElementById('mainCanvas');
      var ctx = canvas.getContext('2d');
      var video = document.getElementById('cameraVideo');
      var source = studioImageObj ? studioImageObj : (video.readyState >= 2 ? video : null);

      var nowMinuteKey = appState.liveClock ? new Date().toTimeString().slice(0, 5) : (appState.manualDate + appState.manualTime);
      if (
        watermarkLayerCanvas.width !== canvas.width ||
        watermarkLayerCanvas.height !== canvas.height ||
        nowMinuteKey !== lastWatermarkClockKey ||
        activeDragKey !== null
      ) {
        watermarkLayerCanvas.width = canvas.width;
        watermarkLayerCanvas.height = canvas.height;
        lastWatermarkClockKey = nowMinuteKey;
        watermarkDirty = true;
      }

      if (watermarkDirty) {
        var wCtx = watermarkLayerCanvas.getContext('2d');
        drawUnifiedWatermark(wCtx, watermarkLayerCanvas.width, watermarkLayerCanvas.height, null, appState, null, null, null, false, true);
        watermarkDirty = false;
      }

      drawSourceFrameOrGrid(ctx, canvas.width, canvas.height, source, false);
      ctx.drawImage(watermarkLayerCanvas, 0, 0);
      requestAnimationFrame(renderLoop);
    }

    // ============================================================================
    // TOUCH DRAG & DROP ENGINE ON CANVAS (pointerdown / pointermove / pointerup)
    // ============================================================================
    function mapPointerToStageCoords(clientX, clientY, rect) {
      var rx = (clientX - rect.left) / rect.width;
      var ry = (clientY - rect.top) / rect.height;
      if (isPortraitViewportWithLandscapeTilt() && rect.width < rect.height) {
        if (physicalLandscapeDir === 'right') {
          return { rx: 1 - ry, ry: rx };
        }
        return { rx: ry, ry: 1 - rx };
      }
      return { rx: rx, ry: ry };
    }

    var pointerDownClockTapCandidate = false;
    var pointerDownTimestamp = 0;
    var pointerDownStartPt = { rx: 0, ry: 0 };

    function isPointInsideClockRegion(rx, ry) {
      var tb = appState.positions.textBlock || { rx: 0.015, ry: 0.68 };
      var minX = Math.max(0, tb.rx - 0.02);
      var maxX = Math.min(1, tb.rx + 0.56);
      var minY = Math.max(0, tb.ry - 0.03);
      var maxY = Math.min(1, tb.ry + 0.16);
      return rx >= minX && rx <= maxX && ry >= minY && ry <= maxY;
    }

    function initCanvasTouchDrag() {
      var canvas = document.getElementById('mainCanvas');
      canvas.addEventListener('pointerdown', function(e) {
        var rect = canvas.getBoundingClientRect();
        var pt = mapPointerToStageCoords(e.clientX, e.clientY, rect);
        var rx = pt.rx;
        var ry = pt.ry;

        pointerDownClockTapCandidate = isPointInsideClockRegion(rx, ry);
        pointerDownTimestamp = Date.now();
        pointerDownStartPt = { rx: rx, ry: ry };

        if (appState.lockPosition) {
          if (pointerDownClockTapCandidate) {
            canvas.setPointerCapture(e.pointerId);
          }
          return;
        }

        // Find closest element hit (skip logo1/logo2 when locked to a Portrait/Landscape Anchor)
        var keys = ['minimap', 'serial', 'logo3', 'textBlock'];
        if (appState.logo1Anchor === 'custom') keys.push('logo1');
        if (appState.logo2Anchor === 'custom') keys.push('logo2');
        var bestKey = null;
        var bestDist = 0.20;
        for (var i = 0; i < keys.length; i++) {
          var k = keys[i];
          var pos = appState.positions[k];
          var dx = rx - (pos.rx + 0.05);
          var dy = ry - (pos.ry + 0.05);
          var dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < bestDist) {
            bestDist = dist;
            bestKey = k;
          }
        }
        if (bestKey) {
          activeDragKey = bestKey;
          var selEl = document.getElementById('selTargetElement');
          if (selEl) selEl.value = bestKey;
          dragOffset.x = rx - appState.positions[bestKey].rx;
          dragOffset.y = ry - appState.positions[bestKey].ry;
          syncPrecisionSlidersFromElement();
          canvas.setPointerCapture(e.pointerId);
        }
      });

      canvas.addEventListener('pointermove', function(e) {
        var rect = canvas.getBoundingClientRect();
        var pt = mapPointerToStageCoords(e.clientX, e.clientY, rect);
        if (pointerDownClockTapCandidate) {
          var moveDist = Math.hypot(pt.rx - pointerDownStartPt.rx, pt.ry - pointerDownStartPt.ry);
          if (moveDist > 0.025) {
            pointerDownClockTapCandidate = false;
          }
        }
        if (!activeDragKey || appState.lockPosition) return;
        appState.positions[activeDragKey].rx = Math.max(0.015, Math.min(0.985, pt.rx - dragOffset.x));
        appState.positions[activeDragKey].ry = Math.max(0.015, Math.min(0.985, pt.ry - dragOffset.y));
        watermarkDirty = true;
        syncPrecisionSlidersFromElement();
      });

      canvas.addEventListener('pointerup', function() {
        var wasClockTap = pointerDownClockTapCandidate && (Date.now() - pointerDownTimestamp < 420);
        pointerDownClockTapCandidate = false;
        if (activeDragKey) {
          activeDragKey = null;
          watermarkDirty = true;
          saveState();
        }
        if (wasClockTap) {
          openCanvasQuickTimeModal();
        }
      });
    }

