    function normalizeFontDataUrl(dataUrl, fileName) {
      var raw = String(dataUrl || '');
      if (raw.indexOf('base64,') === -1) return raw;
      var b64 = raw.split('base64,')[1];
      var ext = String(fileName || '').toLowerCase();
      var mime = 'font/ttf';
      if (ext.indexOf('.otf') !== -1) mime = 'font/otf';
      else if (ext.indexOf('.woff2') !== -1) mime = 'font/woff2';
      else if (ext.indexOf('.woff') !== -1) mime = 'font/woff';
      return 'data:' + mime + ';base64,' + b64;
    }

    function registerDataUrlFontEverywhere(fontName, dataUrl) {
      var clean = String(fontName || '').trim();
      if (!clean || !dataUrl) return;
      // 1. Inject @font-face style tag covering all weights (100-900) so HTML & Canvas 500/600/700 match 100%
      var styleId = 'custom-font-css-' + clean.replace(/[^a-zA-Z0-9]/g, '_').toLowerCase();
      var styleEl = document.getElementById(styleId);
      if (!styleEl) {
        styleEl = document.createElement('style');
        styleEl.id = styleId;
        document.head.appendChild(styleEl);
      }
      styleEl.textContent =
        '@font-face { font-family: "' + clean + '"; src: url("' + dataUrl + '"); font-weight: 100 900; font-style: normal; font-display: block; }\n' +
        '@font-face { font-family: "' + clean + '"; src: url("' + dataUrl + '"); font-weight: normal; font-style: normal; font-display: block; }\n' +
        '@font-face { font-family: "' + clean + '"; src: url("' + dataUrl + '"); font-weight: bold; font-style: normal; font-display: block; }';

      // 2. Also register in document.fonts for normal & bold weights so Android Canvas drawText immediately uses it
      if (window.FontFace && document.fonts) {
        var weights = ['400', '500', '600', '700', '800'];
        for (var w = 0; w < weights.length; w++) {
          (function(wt) {
            try {
              var ff = new FontFace(clean, 'url("' + dataUrl + '")', { weight: wt, style: 'normal' });
              ff.load().then(function(loaded) {
                document.fonts.add(loaded);
                watermarkDirty = true;
                updateSelectedFontPreviewUI();
              }).catch(function() {});
            } catch (e) {}
          })(weights[w]);
        }
      }
    }

    function forceLoadSingleFontForCanvas(fontName) {
      var clean = String(fontName || '').trim();
      if (!clean) return;
      if (appState.customFontData && appState.customFontData[clean]) {
        registerDataUrlFontEverywhere(clean, appState.customFontData[clean]);
      } else {
        injectGoogleFontLink(clean);
      }
      if (document.fonts && document.fonts.load) {
        Promise.all([
          document.fonts.load('700 64px "' + clean + '"'),
          document.fonts.load('600 32px "' + clean + '"'),
          document.fonts.load('500 22px "' + clean + '"'),
          document.fonts.load('400 22px "' + clean + '"')
        ]).then(function() {
          watermarkDirty = true;
          updateSelectedFontPreviewUI();
        }).catch(function() {});
      }
    }

