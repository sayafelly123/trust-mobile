<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="theme-color" content="#0f172a">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <link id="pwaManifestLink" rel="manifest" href="">
  <title>TrustMark — Live Camera & Photo Stamping</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/piexifjs/1.0.6/piexif.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&family=Lora:wght@500;700&family=Montserrat:wght@500;700;800&family=Orbitron:wght@600;800&family=Oswald:wght@500;700&family=Plus+Jakarta+Sans:wght@500;700;800&family=Poppins:wght@400;600;700&family=Rajdhani:wght@600;700&family=Roboto:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap');
    html, body { font-family: 'Inter', sans-serif; background-color: #0f172a; color: #f8fafc; overscroll-behavior: none; overscroll-behavior-x: none; user-select: none; }
    .mono { font-family: 'JetBrains Mono', monospace; }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: #0f172a; }
    ::-webkit-scrollbar-thumb { background: #334155; border-radius: 9999px; }
    .canvas-stage { touch-action: none; }
    .leaflet-container { background: #0f172a; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spin { animation: spin 0.9s linear infinite; }
  </style>
</head>
<body class="h-[100dvh] w-screen overflow-hidden flex flex-col bg-slate-900 text-slate-100">

  <!-- TOP HEADER BAR (Responsive 2-row on Phone, 1-row on Tablet/Desktop, horizontally scrollable nav) -->
  <header id="mainHeaderBar" class="shrink-0 bg-slate-950 border-b border-slate-800 px-2 py-1.5 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-1.5 z-30">
    <div class="flex items-center justify-between gap-1.5">
      <div class="flex items-center gap-1.5 min-w-0">
        <div class="w-6 h-6 shrink-0 rounded-lg bg-amber-500/20 border border-amber-500/40 flex items-center justify-center text-amber-400">
          <i data-lucide="shield-check" class="w-3.5 h-3.5"></i>
        </div>
        <span class="font-bold text-xs tracking-tight text-white shrink-0">Trust<span class="text-amber-400">Mark</span></span>
        <span id="gpsStatusBadge" class="text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 border border-slate-700 truncate">GPS Siap</span>
        <span id="netStatusBadge" class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 shrink-0">Online</span>
      </div>

      <!-- Quick Utility Actions on Phone/Tablet Top-Right -->
      <div class="flex items-center gap-1 shrink-0 lg:hidden">
        <button onclick="openVerifyModal()" class="px-2 py-1 rounded-md text-[10px] font-bold bg-blue-600 hover:bg-blue-500 text-white flex items-center gap-1">
          <i data-lucide="scan-line" class="w-3 h-3"></i><span>Verifikasi</span>
        </button>
        <button onclick="openAndroidNativeModal()" class="px-2 py-1 rounded-md text-[10px] font-bold bg-emerald-600 hover:bg-emerald-500 text-white flex items-center gap-1">
          <i data-lucide="smartphone" class="w-3 h-3"></i><span>Android</span>
        </button>
      </div>
    </div>

    <!-- MAIN MODE NAVIGATION (Scrollable horizontally on small screens so ZERO buttons are ever cut off) -->
    <nav class="w-full lg:w-auto overflow-x-auto no-scrollbar flex items-center gap-1 bg-slate-900 p-1 rounded-lg border border-slate-800">
      <button onclick="switchMainView('camera')" id="navBtn-camera" class="shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium flex items-center gap-1 bg-amber-500 text-slate-950">
        <i data-lucide="camera" class="w-3.5 h-3.5"></i><span>Kamera</span>
      </button>
      <button onclick="switchMainView('studio')" id="navBtn-studio" class="shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium flex items-center gap-1 text-slate-300 hover:text-white">
        <i data-lucide="sliders" class="w-3.5 h-3.5"></i><span>Edit</span>
      </button>
      <button onclick="switchMainView('webadmin')" id="navBtn-webadmin" class="shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium flex items-center gap-1 text-amber-300 hover:text-white border border-amber-500/30 bg-amber-500/10" title="Pengaturan Lengkap (Font, 3 Logo, Batas Tepi 1.5% & Default Cloud)">
        <i data-lucide="monitor-cog" class="w-3.5 h-3.5"></i><span>Advance</span>
      </button>
      <button onclick="switchMainView('batch')" id="navBtn-batch" class="shrink-0 flex px-2.5 py-1 rounded-md text-[11px] font-medium items-center gap-1 text-slate-300 hover:text-white">
        <i data-lucide="layers" class="w-3.5 h-3.5"></i><span>Batch</span>
      </button>
      <button onclick="switchMainView('history')" id="navBtn-history" class="shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium flex items-center gap-1 text-slate-300 hover:text-white">
        <i data-lucide="cloud" class="w-3.5 h-3.5"></i><span>Drive</span>
      </button>
      <button onclick="pushMasterSyncToCloud()" id="btnQuickPushHeader" class="shrink-0 px-2 py-1 rounded-md text-[11px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/40 hover:bg-amber-500/30 flex items-center gap-1" title="Simpan & Kirim Setelan ke Cloud">
        <i data-lucide="cloud-upload" class="w-3 h-3"></i><span id="lblQuickPushHeader">Simpan Sync</span>
      </button>
      <button onclick="pullMasterSyncFromCloud(true)" id="btnQuickSyncHeader" class="shrink-0 px-2 py-1 rounded-md text-[11px] font-semibold bg-emerald-600/20 text-emerald-300 border border-emerald-500/40 hover:bg-emerald-600/30 flex items-center gap-1" title="Tarik Pengaturan Desain dari Cloud">
        <i data-lucide="cloud-download" class="w-3 h-3"></i><span>Tarik Sync</span>
      </button>
      <button onclick="openVerifyModal()" id="btnVerifyPhoto" class="hidden lg:flex shrink-0 px-2 py-1 rounded-md text-[11px] font-bold bg-blue-600 hover:bg-blue-500 text-white items-center gap-1" title="Verifikasi Keaslian Foto TrustMark (Tahan Kompresi WhatsApp)">
        <i data-lucide="scan-line" class="w-3 h-3"></i><span>Verifikasi</span>
      </button>
      <button onclick="openAndroidNativeModal()" id="btnAndroidNative" class="hidden lg:flex shrink-0 px-2 py-1 rounded-md text-[11px] font-bold bg-emerald-600 hover:bg-emerald-500 text-white items-center gap-1" title="Mode Aplikasi Android Native, Penyimpanan Lokal & Build APK">
        <i data-lucide="smartphone" class="w-3 h-3"></i><span>Android</span>
      </button>
      <button onclick="installPwaApp()" id="btnInstallPwa" class="hidden shrink-0 px-2 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 flex items-center gap-1">
        <i data-lucide="download" class="w-3 h-3"></i><span>Install</span>
      </button>
    </nav>
  </header>

  <!-- MAIN WORKSPACE (Clean Full-Screen Camera by default on mobile; Collapsible Drawer) -->
  <main id="workspaceMain" class="flex-1 overflow-hidden flex flex-col md:flex-row-reverse">

    <!-- RIGHT / TOP PANEL: CLEAN UNOBSTRUCTED VIEWPORT (dedicated top & bottom bars, ZERO icons overlapping live photo) -->
    <section id="viewportSection" class="relative w-full flex-1 h-full bg-black flex flex-col items-center justify-between overflow-hidden shrink-0 border-b md:border-b-0 md:border-l border-slate-800">
      
      <!-- Hidden Video Feed for WebRTC Camera -->
      <video id="cameraVideo" playsinline muted autoplay class="hidden"></video>

      <!-- DEDICATED TOP CAMERA BAR (Scrollable on narrow phones so all controls fit cleanly) -->
      <div id="camTopBar" class="w-full shrink-0 bg-slate-950 border-b border-slate-800/80 px-2 py-1 overflow-x-auto no-scrollbar flex items-center justify-between gap-1.5 z-20">
        <div class="flex items-center gap-1 text-[11px] shrink-0">
          <button onclick="toggleFloatingQuickWindow()" id="btnFloatingQuickToggle" class="shrink-0 px-2 py-0.5 rounded bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold flex items-center gap-1 shadow">
            <i data-lucide="SlidersHorizontal" class="w-3 h-3"></i><span>Panel Cepat</span>
          </button>
          <button onclick="toggleLiveGps()" id="btnLiveGps" class="shrink-0 px-2 py-0.5 rounded bg-emerald-600/20 border border-emerald-500/40 text-emerald-300 font-semibold flex items-center gap-1" title="Aktifkan/Matikan Live GPS Mengikuti HP">
            <i data-lucide="locate-fixed" class="w-3 h-3"></i><span id="lblTopLiveGps">Live GPS</span>
          </button>
          <button onclick="toggleLockPosition()" id="lockPosBtn" class="shrink-0 px-2 py-0.5 rounded bg-slate-800 border border-slate-700 text-slate-300 hover:text-white flex items-center gap-1">
            <i data-lucide="unlock" class="w-3 h-3 text-amber-400"></i><span id="lockPosText">Geser: Aktif</span>
          </button>
        </div>

        <div class="flex items-center gap-1 shrink-0">
          <button onclick="toggleOrientationMode()" id="btnRotateMode" class="shrink-0 bg-slate-900 text-[11px] text-amber-400 px-2 py-0.5 rounded border border-slate-700 flex items-center gap-1" title="Mode Auto-Rotate Sensor / Portrait / Landscape">
            <i data-lucide="smartphone" class="w-3 h-3"></i><span id="orientationBadge">Auto: Portrait</span>
          </button>
          <select id="ratioSelect" onchange="changeAspectRatio(this.value)" class="shrink-0 bg-slate-900 text-[11px] text-white px-1.5 py-0.5 rounded border border-slate-700">
            <option value="3:4">3:4</option>
            <option value="9:16">9:16</option>
            <option value="1:1">1:1</option>
          </select>
          <button onclick="openMapModal()" class="shrink-0 bg-emerald-600 hover:bg-emerald-500 text-white text-[11px] font-semibold px-2 py-0.5 rounded flex items-center gap-1">
            <i data-lucide="map-pin" class="w-3 h-3"></i><span>Peta</span>
          </button>
        </div>
      </div>

      <!-- 100% CLEAN LIVE CAMERA & WATERMARK STAGE + FLOATING QUICK WINDOW -->
      <div id="canvasWrapper" class="relative w-full flex-1 min-h-0 flex items-center justify-center overflow-hidden bg-black p-1">
        <canvas id="mainCanvas" width="720" height="960" class="canvas-stage max-w-full max-h-full object-contain rounded shadow-2xl"></canvas>

        <!-- FLOATING QUICK SETUP WINDOW (WAKTU, TANGGAL, PRESET LOKASI, LIVE GPS & OPSI SIMPAN TANPA POP-UP) -->
        <div id="floatingQuickWindow" class="hidden absolute top-2 left-2 right-2 sm:left-auto sm:right-3 sm:w-80 bg-slate-900/95 backdrop-blur-md border border-amber-500/60 rounded-2xl shadow-2xl z-30 overflow-hidden">
          <!-- Floating Window Header (Draggable Handle) -->
          <div id="floatingQuickHeader" class="bg-slate-950/90 px-3 py-2 border-b border-slate-800 flex items-center justify-between cursor-move select-none">
            <div class="flex items-center gap-1.5">
              <i data-lucide="zap" class="w-3.5 h-3.5 text-amber-400"></i>
              <span class="text-xs font-bold text-white">Pengaturan Cepat &amp; Live GPS</span>
            </div>
            <div class="flex items-center gap-1">
              <button type="button" onclick="openLastShotPreviewModal()" id="btnFloatingLastShot" class="hidden px-2 py-0.5 rounded bg-slate-800 hover:bg-slate-700 text-[10px] text-amber-300 font-semibold border border-slate-700">
                Foto Terakhir
              </button>
              <button type="button" onclick="toggleFloatingQuickWindow(false)" class="text-slate-400 hover:text-white p-0.5">
                <i data-lucide="x" class="w-4 h-4"></i>
              </button>
            </div>
          </div>

          <div class="p-2.5 space-y-2.5 max-h-[68vh] overflow-y-auto text-[11px]">
            <!-- 1. PILIHAN AKSI SEBELUM JEPRET (PENGGANTI POP-UP HASIL FOTO) -->
            <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-2 space-y-1.5">
              <div class="flex items-center justify-between">
                <span class="font-bold text-amber-300 flex items-center gap-1">
                  <i data-lucide="camera" class="w-3 h-3"></i> Aksi Otomatis Saat Jepret:
                </span>
                <span class="text-[9px] px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-semibold">Tanpa Pop-up</span>
              </div>
              <div class="grid grid-cols-3 gap-1">
                <label class="flex items-center gap-1 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 cursor-pointer">
                  <input type="checkbox" id="fltChkSaveHp" checked onchange="onFloatingPreCaptureOptionChange()" class="accent-amber-500 rounded">
                  <span class="text-[10px] font-semibold text-white">Simpan HP</span>
                </label>
                <label class="flex items-center gap-1 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 cursor-pointer">
                  <input type="checkbox" id="fltChkSaveDrive" onchange="onFloatingPreCaptureOptionChange()" class="accent-emerald-500 rounded">
                  <span class="text-[10px] font-semibold text-emerald-300">Ke Drive</span>
                </label>
                <label class="flex items-center gap-1 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 cursor-pointer" title="Centang hanya jika ingin menampilkan pop-up pratinjau setelah memotret">
                  <input type="checkbox" id="fltChkShowPopup" onchange="onFloatingPreCaptureOptionChange()" class="accent-blue-500 rounded">
                  <span class="text-[10px] font-semibold text-slate-300">Pop-up</span>
                </label>
              </div>
            </div>

            <!-- 2. LIVE GPS MENGIKUTI HP & PILIHAN PRESET LOKASI -->
            <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-2 space-y-2">
              <div class="flex items-center justify-between gap-1">
                <button type="button" onclick="toggleLiveGps()" id="fltBtnLiveGps" class="flex-1 py-1.5 px-2 rounded-lg font-bold text-[10px] flex items-center justify-center gap-1 bg-emerald-600 text-white shadow">
                  <i data-lucide="navigation" class="w-3 h-3"></i>
                  <span id="fltLblLiveGps">Live GPS HP: Aktif</span>
                </button>
                <button type="button" onclick="forceRefreshLiveGpsNow()" class="px-2 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 text-[10px] font-semibold flex items-center gap-1" title="Kunci Ulang Titik GPS HP Sekarang">
                  <i data-lucide="refresh-cw" class="w-3 h-3"></i><span>Kunci GPS</span>
                </button>
                <button type="button" onclick="openMapModal()" class="px-2 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-emerald-300 border border-slate-700 text-[10px] font-semibold flex items-center gap-1">
                  <i data-lucide="map-pin" class="w-3 h-3"></i><span>Peta</span>
                </button>
              </div>

              <div class="text-[10px] text-slate-300 bg-slate-900/90 rounded-lg px-2 py-1 border border-slate-800/80">
                <div class="flex items-center justify-between text-amber-300 mono text-[9px]">
                  <span id="fltCoordPreview">-6.175392, 106.827153</span>
                  <span id="fltAccPreview">GPS Siap</span>
                </div>
                <div id="fltAddrPreview" class="truncate text-slate-300 mt-0.5">Jl. Desa Nomor 1...</div>
              </div>

              <!-- Dropdown Pilihan Preset Lokasi -->
              <div class="flex items-center gap-1">
                <select id="fltPresetLocationSelect" onchange="applyFloatingLocationPreset(this.value)" class="flex-1 bg-slate-900 border border-slate-700 rounded-lg px-2 py-1.5 text-[11px] text-white font-medium">
                  <option value="">-- Pilih Preset Lokasi Favorit --</option>
                </select>
                <button type="button" onclick="saveCurrentLocationPreset()" class="shrink-0 bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 font-bold px-2 py-1.5 rounded-lg text-[10px]" title="Simpan Lokasi Saat Ini ke Preset">
                  + Simpan
                </button>
              </div>
            </div>

            <!-- 3. PENGATURAN WAKTU & TANGGAL CEPAT -->
            <div class="bg-slate-950/90 border border-slate-800 rounded-xl p-2 space-y-2">
              <div class="flex items-center justify-between">
                <span class="font-bold text-amber-400 flex items-center gap-1">
                  <i data-lucide="clock" class="w-3 h-3"></i> Waktu &amp; Tanggal Foto
                </span>
                <label class="flex items-center gap-1 text-[10px] cursor-pointer bg-slate-900 px-2 py-0.5 rounded border border-slate-700">
                  <input type="checkbox" id="fltChkLiveClock" checked onchange="onFloatingClockToggle(this.checked)" class="accent-amber-500 rounded">
                  <span class="text-amber-300 font-semibold">Jam Live</span>
                </label>
              </div>

              <div class="grid grid-cols-2 gap-1.5">
                <input type="date" id="fltInpDate" onchange="onFloatingDateTimeEdit()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-white font-semibold">
                <input type="time" id="fltInpTime" step="1" onchange="onFloatingDateTimeEdit()" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-2 py-1 text-[11px] text-white font-semibold">
              </div>

              <div class="flex flex-wrap items-center gap-1">
                <button type="button" onclick="quickShiftDate(-1)" class="px-1.5 py-1 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[10px] text-slate-200 font-semibold">H-1</button>
                <button type="button" onclick="quickShiftDate(0)" class="px-1.5 py-1 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[10px] text-emerald-300 font-semibold">Hari Ini</button>
                <button type="button" onclick="quickShiftMinutes(-10)" class="px-1.5 py-1 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[10px] text-slate-200 mono">-10m</button>
                <button type="button" onclick="quickShiftMinutes(-1)" class="px-1.5 py-1 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[10px] text-slate-200 mono">-1m</button>
                <button type="button" onclick="quickShiftMinutes(1)" class="px-1.5 py-1 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[10px] text-slate-200 mono">+1m</button>
                <button type="button" onclick="quickShiftMinutes(10)" class="px-1.5 py-1 rounded bg-slate-900 hover:bg-slate-800 border border-slate-700 text-[10px] text-slate-200 mono">+10m</button>
                <button type="button" onclick="openCanvasQuickTimeModal()" class="px-1.5 py-1 rounded bg-slate-800 hover:bg-slate-700 border border-slate-600 text-[10px] text-amber-300 font-semibold ml-auto">Jarum</button>
                <button type="button" onclick="resetToLiveNow()" class="px-1.5 py-1 rounded bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-[10px] text-amber-300 font-bold">Live</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- DEDICATED BOTTOM SHUTTER & CONTROLS BAR (Outside canvas so it NEVER covers Clock, Address or TrustMark logo) -->
      <div id="shutterBar" class="w-full shrink-0 flex items-center justify-around px-3 py-2 bg-slate-950 border-t border-slate-800 z-20">
        <!-- Toggle Hide/Show Studio Panel -->
        <button onclick="toggleControlPanel()" id="btnTogglePanel" class="flex flex-col items-center gap-0.5 text-amber-400 hover:text-amber-300 text-[10px]">
          <div class="w-8 h-8 rounded-full bg-slate-800 border border-amber-500/50 flex items-center justify-center">
            <i data-lucide="sliders" class="w-4 h-4"></i>
          </div>
          <span id="lblTogglePanel">Atur Teks</span>
        </button>

        <!-- Upload 1 or Multiple Photos from Phone Memory for Post-Capture Edit -->
        <label class="flex flex-col items-center gap-0.5 text-slate-300 hover:text-amber-400 text-[10px] cursor-pointer">
          <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
            <i data-lucide="image-plus" class="w-4 h-4"></i>
          </div>
          <span>Edit Foto HP</span>
          <input type="file" accept="image/*" multiple onchange="handleStudioPhotoUpload(event)" class="hidden">
        </label>

        <!-- MAIN SHUTTER / RENDER BUTTON -->
        <button onclick="captureAndStampPhoto()" id="btnShutter" class="group relative w-13 h-13 p-3.5 rounded-full bg-amber-500 hover:bg-amber-400 active:scale-95 transition flex items-center justify-center shadow-lg shadow-amber-500/30 border-4 border-slate-800">
          <i data-lucide="camera" class="w-6 h-6 text-slate-950"></i>
        </button>

        <!-- Switch Front/Back Camera or Return to Live Camera -->
        <button onclick="switchCameraFacing()" id="btnFlipCam" class="flex flex-col items-center gap-0.5 text-slate-300 hover:text-white text-[10px]">
          <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
            <i data-lucide="refresh-cw" class="w-4 h-4"></i>
          </div>
          <span id="lblFlipCam">Kamera</span>
        </button>

        <!-- Neat Auto-Align Layout -->
        <button onclick="resetElementPositions()" class="flex flex-col items-center gap-0.5 text-slate-300 hover:text-amber-400 text-[10px]">
          <div class="w-8 h-8 rounded-full bg-slate-800 border border-slate-700 flex items-center justify-center">
            <i data-lucide="layout-template" class="w-4 h-4"></i>
          </div>
          <span>Rapikan</span>
        </button>
      </div>
    </section>

    <!-- LEFT / BOTTOM PANEL: CONTROLS, STUDIO TABS, BATCH & DRIVE HISTORY (Hidden by default on mobile for clean camera) -->
    <section id="controlSection" class="hidden w-full md:w-5/12 h-[52vh] md:h-full bg-slate-900 flex flex-col overflow-hidden border-t border-slate-800">

      <!-- SUB-NAVIGATION FOR CAMERA / STUDIO EDIT TABS (All 4 tabs visible & scrollable on Phone & Tablet) -->
      <div id="editorSubTabs" class="flex items-center justify-between border-b border-slate-800 bg-slate-950/60 px-2 pt-1 gap-1 shrink-0">
        <div class="flex items-center gap-1 overflow-x-auto no-scrollbar min-w-0 flex-1">
          <button onclick="switchEditorTab('quick')" id="edTab-quick" class="shrink-0 px-2.5 py-2 text-xs font-semibold border-b-2 border-amber-500 text-amber-400 whitespace-nowrap flex items-center gap-1">
            <i data-lucide="zap" class="w-3.5 h-3.5"></i> Cepat
          </button>
