        }
        var file = batchFilesQueue[idx];
        var reader = new FileReader();
        reader.onload = function(ev) {
          var img = new Image();
          img.onload = function() {
            var photoTime = new Date(baseDate.getTime() + (idx * stepMinutes * 60000));
            var tzOff = photoTime.getTimezoneOffset() * 60000;
            var dStr = new Date(photoTime.getTime() - tzOff).toISOString().slice(0, 10);
            var tStr = photoTime.toTimeString().slice(0, 8);
            var clk = formatIndonesianDateObject(dStr, tStr, false);
            var jittered = applyMicroJitterCoords(appState.lat, appState.lng, true, idx + 1);
            var code = generateRandomCode(14);

            var dims = getHdDimensionsForRatio(appState.aspectRatio, appState.hdQualityMode);
            var c = document.createElement('canvas');
            c.width = dims.shortSide;
            c.height = dims.longSide;
            drawUnifiedWatermark(c.getContext('2d'), c.width, c.height, img, appState, clk, jittered, code, true);
            var compBatch = encodeCrispHdJpeg(c, appState.hdQualityMode);
            var stampedUrl = injectExifIntoJpeg(compBatch.dataUrl, appState.exifDevice, clk.exifDateStr, jittered.lat, jittered.lng, c.width, c.height, appState.altitude, code);

            appendBatchResultCard(stampedUrl, code, clk.timeHM, jittered);
            idx++;
            setTimeout(processNext, 60);
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      }
      processNext();
