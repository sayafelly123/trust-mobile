    function applyIncomingPhoneGpsPosition(pos, forceAddressRefresh) {
      if (!pos || !pos.coords) return;
      var newLat = parseFloat(pos.coords.latitude.toFixed(6));
      var newLng = parseFloat(pos.coords.longitude.toFixed(6));
      var movedDistMeters = Math.hypot((newLat - lastGeocodeLat) * 111320, (newLng - lastGeocodeLng) * 111320);

      appState.lat = newLat;
      appState.lng = newLng;
      if (pos.coords.altitude !== null && !isNaN(pos.coords.altitude)) {
        appState.altitude = parseFloat(Number(pos.coords.altitude).toFixed(1));
        if (document.getElementById('inpAltitude')) document.getElementById('inpAltitude').value = appState.altitude;
      }
      appState.gpsAccuracy = Math.max(1, Math.round(pos.coords.accuracy || 4));
      document.getElementById('inpLat').value = appState.lat;
      document.getElementById('inpLng').value = appState.lng;

      updateLiveGpsVisualButtons();
      syncFloatingWindowUI();
      watermarkDirty = true;

      var nowMs = Date.now();
      if (forceAddressRefresh || movedDistMeters > 6 || (nowMs - lastGeocodeTime > 20000 && movedDistMeters > 1.5)) {
        lastGeocodeLat = newLat;
        lastGeocodeLng = newLng;
        lastGeocodeTime = nowMs;
        updateMinimapTile(appState.lat, appState.lng);
        fetchReverseGeocode(appState.lat, appState.lng, true);
      }
    }

