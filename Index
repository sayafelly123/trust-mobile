    function createThumbnailDataUrl(sourceDataUrl, callback) {
      var img = new Image();
      img.onload = function() {
        var c = document.createElement('canvas');
        c.width = 270;
        c.height = Math.round(270 * (img.height / img.width));
        c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
        callback(c.toDataURL('image/jpeg', 0.65));
      };
      img.src = sourceDataUrl;
