    function findNewestValidSyncPreset() {
      // Search newest valid JSON preset (skips any legacy row truncated at 48,000 chars)
      for (var i = cloudPresets.logo.length - 1; i >= 0; i--) {
        var item = cloudPresets.logo[i];
        if (item.name === MASTER_SYNC_NAME) {
          try {
            var parsed = JSON.parse(item.dataJson);
            if (parsed && typeof parsed === 'object') return { item: item, parsed: parsed };
          } catch (e) {}
        }
      }
      for (var j = cloudPresets.logo.length - 1; j >= 0; j--) {
        try {
          var parsedFallback = JSON.parse(cloudPresets.logo[j].dataJson);
          if (parsedFallback && typeof parsedFallback === 'object') {
            return { item: cloudPresets.logo[j], parsed: parsedFallback };
          }
        } catch (e2) {}
      }
      return null;
    }

