        cloudPresets.location = (data && data.locations) ? data.locations : [];
        cloudPresets.logo = (data && data.logos) ? data.logos : [];
        renderPresetLists();

        if (isStartup && isAutoPullSyncEnabled()) {
          var validHit = findNewestValidSyncPreset();
          if (validHit) {
            applyFullTemplateData(validHit.parsed, null);
            var sub = document.getElementById('syncStatusSub');
            if (sub) sub.textContent = 'Tersinkron otomatis dengan Setelan Web (' + (validHit.item.updatedAt ? validHit.item.updatedAt.slice(11, 16) : 'Cloud') + ')';
          }
        }
        initialCloudSyncDone = true;
      }, function() {
        initialCloudSyncDone = true;
      });
    }

