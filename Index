    function loadSavedState() {
      try {
        var raw = localStorage.getItem('trustmark_state_v1');
        if (raw) {
          var parsed = JSON.parse(raw);
          for (var k in parsed) {
            if (k === 'positions' && parsed.positions) {
              for (var pk in parsed.positions) { appState.positions[pk] = parsed.positions[pk]; }
            } else if (k === 'subOffsets' && parsed.subOffsets) {
              for (var sk in parsed.subOffsets) { appState.subOffsets[sk] = parsed.subOffsets[sk]; }
            } else {
              appState[k] = parsed[k];
            }
          }
        }
      } catch (e) {}
      var now = new Date();
      var tzOffsetMs = now.getTimezoneOffset() * 60000;
      var localIso = new Date(now.getTime() - tzOffsetMs).toISOString();
      appState.manualDate = localIso.slice(0, 10);
      appState.manualTime = now.toTimeString().slice(0, 8);
      // Ensure 14-char photoCode & vertical serialCode are synced with TrustMark cryptographic checksum
      if (!appState.photoCode || appState.photoCode.length !== 14 || !verifyTrustMarkCodeChecksum(appState.photoCode)) {
        appState.photoCode = generateRandomCode(14);
      }
      appState.serialCode = appState.photoCode;
      if (Array.isArray(appState.customFonts)) {
        for (var fi = 0; fi < appState.customFonts.length; fi++) {
          injectGoogleFontLink(appState.customFonts[fi]);
          appendFontOptionToSelects(appState.customFonts[fi]);
        }
      }
      activateAndLoadCanvasFonts();
      if (appState.logo1DataUrl) { loadLogoImageFromDataUrl(1, appState.logo1DataUrl); }
      if (appState.logo2DataUrl) { loadLogoImageFromDataUrl(2, appState.logo2DataUrl); }
      if (appState.logo3DataUrl) { loadLogoImageFromDataUrl(3, appState.logo3DataUrl); }
    }

