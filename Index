      var snapFolder = appState.driveFolderUrl || 'https://drive.google.com/drive/folders/1r-lfCN2jz6noCazhbadezLz0GvIcP7ef?usp=drive_link';
      var snapDev = appState.exifDevice;
      var snapStateJson = JSON.stringify(appState);
      var snapJpeg = lastRenderedDataUrl;

      createThumbnailDataUrl(snapJpeg, function(thumbUrl) {
        savePhotoToLocalOfflineHistory({
          id: 'LOC-' + Date.now(),
          fileName: fileName,
          base64Jpeg: snapJpeg,
          thumbnail: thumbUrl,
