    // LOGO UPLOAD (CRISP WEBP/PNG AUTO-COMPRESSED SO CLOUD SYNC NEVER TRUNCATES AT 48KB)
    function compressLogoDataUrl(rawUrl, maxDim, callback) {
      if (!rawUrl) { callback(''); return; }
      var img = new Image();
      img.onload = function() {
        var limitDim = maxDim || 160;
        var w = img.naturalWidth || img.width || limitDim;
        var h = img.naturalHeight || img.height || limitDim;
        if (w > limitDim || h > limitDim) {
          var scale = limitDim / Math.max(w, h);
          w = Math.max(1, Math.round(w * scale));
          h = Math.max(1, Math.round(h * scale));
        }
        var c = document.createElement('canvas');
        c.width = w;
        c.height = h;
        var lCtx = c.getContext('2d');
        lCtx.imageSmoothingEnabled = true;
        lCtx.imageSmoothingQuality = 'high';
        lCtx.drawImage(img, 0, 0, w, h);
        // ponytail: guarantee <= 11,500 chars per logo across Chrome (WebP) & Safari (PNG fallback) so 3 logos + state < 42KB
        var outUrl = c.toDataURL('image/webp', 0.80);
        var curScale = 0.78;
        while (outUrl.length > 11500 && curScale >= 0.35) {
          var sw = Math.max(48, Math.round(w * curScale));
          var sh = Math.max(48, Math.round(h * curScale));
          var cs = document.createElement('canvas');
          cs.width = sw;
          cs.height = sh;
          var sCtx = cs.getContext('2d');
          sCtx.imageSmoothingEnabled = true;
          sCtx.imageSmoothingQuality = 'high';
          sCtx.drawImage(img, 0, 0, sw, sh);
          outUrl = cs.toDataURL('image/webp', 0.72);
          if (outUrl.length > 11500) {
            outUrl = cs.toDataURL('image/png');
          }
          curScale -= 0.14;
        }
        callback(outUrl);
      };
      img.onerror = function() { callback(''); };
      img.src = rawUrl;
    }

